# Il vecchio file [global-dns] non funziona col plugin systemd-resolved: toglie il DNS della rete
# senza mettere i server scelti. Il DNS di CielOS ora sta nelle connessioni (e in /etc/cielos/dns.conf).
dns_vecchio() {
    [ -f /etc/NetworkManager/conf.d/20-cielos-dns.conf ] || return 0
    rm -f /etc/NetworkManager/conf.d/20-cielos-dns.conf
    nmcli general reload conf,dns-full >/dev/null 2>&1 || true
    for d in $(nmcli -t -f DEVICE,TYPE,STATE device status 2>/dev/null \
               | awk -F: '$2 ~ /^(wifi|ethernet)$/ && $3 == "connected" {print $1}'); do
        # il vecchio [global-dns] non mandava niente a resolved: rimettiamo il DNS che sa NetworkManager
        s=$(nmcli -t -f IP4.DNS,IP6.DNS device show "$d" 2>/dev/null | cut -d: -f2- | tr '\n' ' ')
        if [ -n "$s" ]; then resolvectl dns "$d" $s; else resolvectl revert "$d"; fi
    done
    return 0
}

post_install() {
    systemd-tmpfiles --create /usr/lib/tmpfiles.d/cielos.conf >/dev/null 2>&1
    dns_vecchio
    /usr/lib/cielos/identita.sh nome >/dev/null 2>&1
    /usr/lib/cielos/cielos-repo
    # le voci di Discord/Vesktop in /usr/local/share: il menu le vede subito
    update-desktop-database -q /usr/local/share/applications >/dev/null 2>&1 || true
    systemctl --global enable cield.service cielos-medico.timer >/dev/null 2>&1
    # (da EndeavourOS e Garuda) ogni settimana i pacchetti scaricati vecchi se ne vanno da soli (restano le ultime 3)
    systemctl enable paccache.timer >/dev/null 2>&1
    echo ">> CielOS installato. Configurazione di sistema (login, rete, firewall, istantanee, avvio col logo):"
    echo ">>   sudo cielos-sistema       e per i driver giusti per questo PC:   sudo cielos-hardware installa"
}
post_upgrade() {
    systemd-tmpfiles --create /usr/lib/tmpfiles.d/cielos.conf >/dev/null 2>&1
    dns_vecchio
    /usr/lib/cielos/cielos-nome-kernel.sh >/dev/null 2>&1   # il menu di avvio: «CielOS-<versione>»
    systemctl --global enable cielos-medico.timer >/dev/null 2>&1
    /usr/lib/cielos/identita.sh nome >/dev/null 2>&1
    # la schermata d'avvio è anche nell'initramfs: se il tema è attivo, la copia va rifatta subito
    /usr/lib/cielos/aggiorna-avvio >/dev/null 2>&1 || true
    /usr/lib/cielos/cielos-repo
    # le voci di Discord/Vesktop in /usr/local/share: il menu le vede subito dopo l'aggiornamento
    update-desktop-database -q /usr/local/share/applications >/dev/null 2>&1 || true
    # le novità di sistema anche sui PC già installati (cielos-sistema le mette solo all'installazione)
    systemctl enable systemd-oomd.service plocate-updatedb.timer paccache.timer >/dev/null 2>&1
    [ -f /etc/snapper/configs/root ] && systemctl enable snapper-cleanup.timer >/dev/null 2>&1
    true
}
pre_remove() {
    systemctl --global disable cield.service cielos-medico.timer >/dev/null 2>&1
    /usr/lib/cielos/identita.sh togli >/dev/null 2>&1 || true
}
