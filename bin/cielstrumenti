#!/usr/bin/env python3
"""
CielOS CLI Suite - Strumenti Avanzati per Gestione Sistema, Rete ed Energia
Comando unificato: `cielstrumenti <sottocomando> [opzioni]`
"""

import sys
import os
import argparse
import subprocess
import json

def sistema_info():
    """Mostra informazioni dettagliate sul sistema CielOS e hardware"""
    print("=== CIELOS SYSTEM INFO ===")
    
    # Kernel & OS
    try:
        kernel = subprocess.check_output(["uname", "-sr"], text=True).strip()
        print(f"OS/Kernel: {kernel}")
    except Exception:
        pass

    # CPU
    try:
        cpu = subprocess.check_output("lscpu | grep 'Model name' | cut -d':' -f2", shell=True, text=True).strip()
        print(f"CPU: {cpu}")
    except Exception:
        pass

    # GPU
    try:
        gpu = subprocess.check_output("nvidia-smi --query-gpu=gpu_name,driver_version,memory.total --format=csv,noheader 2>/dev/null || lspci | grep -i vga", shell=True, text=True).strip()
        print(f"GPU: {gpu}")
    except Exception:
        pass

    # RAM
    try:
        ram = subprocess.check_output("free -h | grep Mem | awk '{print $3 \" / \" $2}'", shell=True, text=True).strip()
        print(f"RAM Usata: {ram}")
    except Exception:
        pass

    # Archiviazione
    try:
        disk = subprocess.check_output("df -h / | tail -1 | awk '{print $3 \" / \" $2 \" (\" $5 \")\"}'", shell=True, text=True).strip()
        print(f"Disco /: {disk}")
    except Exception:
        pass

def rete_test():
    """Esegue un test di rete completo (ping, velocita, interfacce)"""
    print("=== CIELOS NETWORK DIAGNOSTICS ===")
    
    # Interfacce
    print("\n--- Interfacce di Rete ---")
    try:
        ip_out = subprocess.check_output("ip -br addr", shell=True, text=True).strip()
        print(ip_out)
    except Exception as e:
        print(f"Errore: {e}")

    # Latenza Ping
    print("\n--- Test Latenza Ping ---")
    targets = ["1.1.1.1", "8.8.8.8", "quad9.net"]
    for target in targets:
        try:
            res = subprocess.check_output(f"ping -c 3 -W 2 {target} | grep rtt", shell=True, text=True).strip()
            print(f"{target}: {res}")
        except Exception:
            print(f"{target}: Raggiungibile/Timeout")

def energia_profilo(profilo=None):
    """Gestisce i profili di risparmio energetico/prestazioni"""
    print("=== CIELOS POWER MANAGEMENT ===")
    
    if profilo:
        print(f"Impostazione profilo energetico: {profilo}")
        if profilo == "performance":
            subprocess.run("sudo powerprofilesctl set performance 2>/dev/null || powerprofilesctl set performance 2>/dev/null || echo 'Prestazioni massime attivate'", shell=True)
            subprocess.run("echo performance | sudo tee /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor 2>/dev/null", shell=True)
        elif profilo == "powersave":
            subprocess.run("sudo powerprofilesctl set power-saver 2>/dev/null || powerprofilesctl set power-saver 2>/dev/null || echo 'Risparmio energetico attivato'", shell=True)
            subprocess.run("echo powersave | sudo tee /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor 2>/dev/null", shell=True)
        elif profilo == "balanced":
            subprocess.run("sudo powerprofilesctl set balanced 2>/dev/null || powerprofilesctl set balanced 2>/dev/null || echo 'Profilo bilanciato attivato'", shell=True)
        print(f"Profilo impostato su: {profilo}")
    else:
        try:
            curr = subprocess.check_output("powerprofilesctl get 2>/dev/null || cat /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor 2>/dev/null", shell=True, text=True).strip()
            print(f"Profilo Corrente: {curr}")
        except Exception:
            print("Impossibile determinare il profilo corrente")

def main():
    parser = argparse.ArgumentParser(description="CielOS CLI Suite - Strumenti Sistema, Rete ed Energia")
    subparsers = parser.add_subparsers(dest="comando", help="Sottocomando da eseguire")

    # Sistema
    sys_parser = subparsers.add_parser("sistema", help="Informazioni e stato del sistema")
    
    # Rete
    net_parser = subparsers.add_parser("rete", help="Diagnostica e test della rete")
    
    # Energia
    pwr_parser = subparsers.add_parser("energia", help="Gestione dei profili energetici")
    pwr_parser.add_argument("profilo", nargs="?", choices=["performance", "balanced", "powersave"], help="Imposta il profilo energetico")

    args = parser.parse_args()

    if args.comando == "sistema":
        sistema_info()
    elif args.comando == "rete":
        rete_test()
    elif args.comando == "energia":
        energia_profilo(args.profilo)
    else:
        parser.print_help()

if __name__ == "__main__":
    main()
