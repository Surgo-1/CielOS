#!/usr/bin/env python3
"""cielctl — parlare con cield (il sistema nervoso di CielOS).

  cielctl eventi [schema…]      guarda gli eventi mentre succedono (es. cielctl eventi "finestra.*" gioco.inizio)
  cielctl regole [--json]       le automazioni, descritte in italiano (e quelle con errori)
  cielctl nuova NOME            crea un'automazione da scrivere (in pausa finché non la riprendi) e dice il file
  cielctl prova FILE.toml       controlla una regola senza installarla e dice cosa farebbe
  cielctl aggiungi FILE.toml    la controlla e la mette tra le automazioni
  cielctl togli NOME            toglie un'automazione (il file va nel cestino della cartella: .tolte/)
  cielctl pausa NOME / riprendi NOME
  cielctl esegui NOME           fa subito le sue azioni (per provarla)
  cielctl emetti EVENTO [JSON]  manda un evento tuo (mio.* o ciel.*)
  cielctl registro              le ultime automazioni scattate e com'è andata
  cielctl stato                 fonti accese, iscritti, memoria usata
  cielctl ricarica"""
import json, os, re, socket, sys, time
from pathlib import Path

RT = os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}")
SOCKET = os.path.join(RT, "cield.sock")
CARTELLA = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config")) / "cielos" / "automazioni"


def connetti():
    s = socket.socket(socket.AF_UNIX)
    try:
        s.connect(SOCKET)
    except OSError:
        sys.exit("cield non è acceso (systemctl --user start cield)")
    return s


def chiedi(m):
    s = connetti()
    s.sendall((json.dumps(m) + "\n").encode())
    f = s.makefile("r", encoding="utf-8")
    r = json.loads(f.readline() or "{}")
    s.close()
    return r


MODELLO = """# Un'automazione di CielOS. È in pausa: quando è pronta metti «attiva = true» (o «cielctl riprendi»).
# Gli eventi e le azioni possibili: «cielctl eventi» li mostra mentre succedono; la guida è in ~/cielos/cield/regole.py
attiva = false
nome = "{nome}"

[quando]
evento = "gioco.inizio"          # es. finestra.aperta, notifica, dispositivo.collegato, orario…

# [se]                           # facoltativo: condizioni
# classe = {{ contiene = "steam" }}
# ora_tra = ["22:00", "07:00"]

# [ritmo]                        # facoltativo
# finche = "gioco.fine"          # le azioni tornano com'erano quando arriva questo evento

[[fai]]
azione = "notifica"              # es. non_disturbare, profilo_energetico, volume, media, apri, ciel_di…
titolo = "Ciel"
testo = "È iniziato un gioco: {{classe}}"   # {{campo}} = un campo dell'evento
"""


def _file(nome):
    """NOME o NOME.toml nella cartella delle automazioni."""
    p = CARTELLA / (nome if nome.endswith(".toml") else nome + ".toml")
    if not p.exists():
        sys.exit(f"non trovo {p.name} in {CARTELLA}")
    return p


def _attiva(p, si):
    t = p.read_text(encoding="utf-8")
    if re.search(r"(?m)^attiva\s*=", t):
        t = re.sub(r"(?m)^attiva\s*=.*$", f"attiva = {'true' if si else 'false'}", t, count=1)
    else:
        t = f"attiva = {'true' if si else 'false'}\n" + t
    tmp = p.with_suffix(".tmp")
    tmp.write_text(t, encoding="utf-8")
    tmp.replace(p)


def main():
    a = sys.argv[1:]
    if not a or a[0] in ("-h", "--help", "--aiuto", "aiuto", "help"):
        print(__doc__.strip()); return
    c, resto = a[0], a[1:]
    if c == "eventi":
        s = connetti()
        s.sendall((json.dumps({"cmd": "iscrivi", "eventi": resto or ["*"]}) + "\n").encode())
        f = s.makefile("r", encoding="utf-8")
        f.readline()
        try:
            for riga in f:
                e = json.loads(riga)
                print(time.strftime("%H:%M:%S", time.localtime(e["t"])), e["evento"],
                      json.dumps(e["dati"], ensure_ascii=False), flush=True)
        except KeyboardInterrupt:
            pass
        return
    if c == "regole":
        r = chiedi({"cmd": "regole"})
        if "--json" in resto:
            print(json.dumps(r, ensure_ascii=False)); return
        for x in r.get("regole", []):
            print(f"• {x['nome']} ({x['file']})\n  {x['descrizione']}")
        for n, e in (r.get("errori") or {}).items():
            print(f"✗ {n}: {'; '.join(e)}")
        if not r.get("regole") and not r.get("errori"):
            print(f"Nessuna automazione (cartella: {r.get('cartella')}).")
        return
    if c in ("prova", "aggiungi"):
        if not resto:
            sys.exit(f"cielctl {c} FILE.toml")
        p = Path(resto[0])
        r = chiedi({"cmd": "prova", "testo": p.read_text(encoding="utf-8")})
        if not r.get("ok"):
            sys.exit("Non va bene:\n  " + "\n  ".join(r.get("errori") or [r.get("errore", "?")]))
        print(r["descrizione"])
        if c == "aggiungi":
            CARTELLA.mkdir(parents=True, exist_ok=True)
            dest = CARTELLA / p.name
            tmp = dest.with_suffix(".tmp")
            tmp.write_text(p.read_text(encoding="utf-8"), encoding="utf-8")
            tmp.replace(dest)
            chiedi({"cmd": "ricarica"})
            print(f"Aggiunta: {dest}")
        return
    if c == "nuova":
        import unicodedata
        nome = " ".join(resto).strip() or "Nuova automazione"
        slug = re.sub(r"[^a-z0-9]+", "-", unicodedata.normalize("NFKD", nome.lower()).encode("ascii", "ignore").decode()).strip("-") or "nuova"
        CARTELLA.mkdir(parents=True, exist_ok=True)
        p, i = CARTELLA / f"{slug}.toml", 2
        while p.exists():
            p, i = CARTELLA / f"{slug}-{i}.toml", i + 1
        p.write_text(MODELLO.format(nome=nome), encoding="utf-8")
        print(p)
        return
    if c == "togli":
        p = _file(resto[0])
        (CARTELLA / ".tolte").mkdir(exist_ok=True)
        p.replace(CARTELLA / ".tolte" / p.name)
        chiedi({"cmd": "ricarica"})
        print(f"Tolta (resta in {CARTELLA / '.tolte'} se la rivuoi).")
        return
    if c in ("pausa", "riprendi"):
        _attiva(_file(resto[0]), c == "riprendi")
        chiedi({"cmd": "ricarica"})
        print("In pausa." if c == "pausa" else "Ripresa.")
        return
    if c == "esegui":
        r = chiedi({"cmd": "esegui", "file": _file(resto[0]).name})
        print("\n".join(r.get("esiti") or [r.get("errore", "?")]))
        return
    if c == "emetti":
        dati = json.loads(resto[1]) if len(resto) > 1 else {}
        r = chiedi({"cmd": "emetti", "evento": resto[0], "dati": dati})
        print("ok" if r.get("ok") else r.get("errore"))
        return
    if c == "registro":
        for x in chiedi({"cmd": "registro"}).get("registro", []):
            print(time.strftime("%d/%m %H:%M:%S", time.localtime(x["t"])), x["regola"],
                  "(ripristino)" if x["ripristino"] else "", "<-", x["evento"], "|", "; ".join(x["esiti"]))
        return
    if c in ("stato", "ricarica"):
        print(json.dumps(chiedi({"cmd": c}), ensure_ascii=False, indent=1))
        return
    sys.exit(f"comando sconosciuto: {c} (cielctl aiuto)")


if __name__ == "__main__":
    main()
