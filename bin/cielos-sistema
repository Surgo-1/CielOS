#!/bin/bash
# La configurazione di sistema di CielOS (da root), dopo aver installato il pacchetto «cielos»: la usa
# l'installatore della ISO (dentro il sistema nuovo) e si può rilanciare quando vuoi. Rifà solo quello che manca.
#   cielos-sistema            servizi (login, rete, energia, firewall, bluetooth), istantanee, ondate, avvio col logo
#   cielos-sistema --senza-avvio      tutto tranne menu e schermata di avvio (es. nei container)
set -u
[ "$(id -u)" = 0 ] || { echo "serve root: sudo $0"; exit 1; }
R=${CIELOS_DIR:-/usr/share/cielos}
AVVIO=1; [ "${1:-}" = "--senza-avvio" ] && AVVIO=0
CHROOT=0; systemd-detect-virt -q --chroot 2>/dev/null && CHROOT=1       # dall'installatore, dentro il sistema nuovo
passo() { echo "── $*"; }
abilita() { if ! systemctl is-enabled -q "$1" 2>/dev/null; then systemctl enable -q "$1" 2>/dev/null && echo "   $1"; fi; }

passo "Servizi"
abilita cielos-avvio.service
DM=$(systemctl show -p Id --value display-manager.service 2>/dev/null)
if [ -z "$DM" ] || [ "$DM" = display-manager.service ]; then abilita sddm.service; fi
ALTRO=""
for s in systemd-networkd iwd dhcpcd connman; do systemctl is-enabled -q "$s" 2>/dev/null && ALTRO=$s; done
[ -z "$ALTRO" ] && abilita NetworkManager.service
abilita power-profiles-daemon.service
[ -d /sys/class/bluetooth ] && ls /sys/class/bluetooth/ 2>/dev/null | grep -q . && pacman -Qq bluez >/dev/null 2>&1 && abilita bluetooth.service
systemctl --global enable -q cield.service 2>/dev/null

passo "Firewall"
if [ $CHROOT = 1 ] && command -v ufw >/dev/null; then
    # dentro un chroot il firewall non si accende (niente kernel suo): pronto per il primo avvio
    sed -i 's/^ENABLED=.*/ENABLED=yes/' /etc/ufw/ufw.conf
    sed -i 's/^DEFAULT_INPUT_POLICY=.*/DEFAULT_INPUT_POLICY="DROP"/' /etc/default/ufw
    abilita ufw.service
elif command -v ufw >/dev/null && ! ufw status 2>/dev/null | grep -q "Status: active"; then
    ufw --force disable >/dev/null 2>&1
    if systemctl is-enabled -q sshd 2>/dev/null; then ufw allow ssh >/dev/null; fi
    ufw --force enable >/dev/null 2>&1 || ufw default deny incoming >/dev/null
    abilita ufw.service
fi

passo "Istantanee"
if [ "$(findmnt -no FSTYPE /)" = btrfs ] && [ ! -f /etc/snapper/configs/root ]; then
    snapper --no-dbus -c root create-config / && echo "   snapper: configurazione root"
fi

passo "Ondate"
if ! grep -q '^\[cachyos' /etc/pacman.conf && ! grep -q cielos-ondata /etc/pacman.conf; then
    sh "$R/guardiano/sistema/installa.sh" ondate
fi

passo "Nome e logo"
/usr/lib/cielos/identita.sh nome
if [ $AVVIO = 1 ]; then
    if [ -f /etc/mkinitcpio.conf.d/cielos-plymouth.conf ] && [ "$(plymouth-set-default-theme 2>/dev/null)" = cielos ]; then
        echo "   avvio con il logo: c'è già"
    else
        /usr/lib/cielos/identita.sh avvio
    fi
fi
echo "Fatto."
