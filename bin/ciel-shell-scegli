#!/bin/sh
# Quale shell usare: Ciel (la nostra) o caelestia. Si cambia al volo, senza riavviare né uscire.
#   ciel-shell-scegli ciel        la shell Ciel (con dentro l'avatar)
#   ciel-shell-scegli caelestia   torna a caelestia (e all'avatar di Ciel separato)
#   ciel-shell-scegli             dice quale è attiva
SEGNO="$HOME/.config/cielos/shell-attiva"
case "$1" in
  ciel|cielos)
    mkdir -p "$(dirname "$SEGNO")"; touch "$SEGNO"
    qs -c caelestia kill >/dev/null 2>&1
    systemctl --user stop ciel-avatar.service 2>/dev/null
    systemctl --user daemon-reload
    systemctl --user start ciel-shell.service
    hyprctl reload >/dev/null
    echo "Shell Ciel attiva. Per tornare indietro: ciel-shell-scegli caelestia"
    ;;
  caelestia)
    rm -f "$SEGNO"
    systemctl --user stop ciel-shell.service
    setsid -f qs -c caelestia -n -d >/dev/null 2>&1
    systemctl --user start ciel-avatar.service 2>/dev/null
    hyprctl reload >/dev/null
    echo "Tornata caelestia."
    ;;
  "")
    [ -e "$SEGNO" ] && echo "ciel" || echo "caelestia"
    ;;
  *)
    echo "uso: ciel-shell-scegli [ciel|caelestia]"; exit 1 ;;
esac
