def pacchetto(nome):
    """Le chiavi che quel preset regola: lo sfondo si mette solo se quel file c'è (in un'installazione vecchia no)."""
    d = dict(PRESET[nome])
    if d.get("sfondo") and not Path(d["sfondo"]).is_file():
        del d["sfondo"]
    return d


# ── colori ────────────────────────────────────────────────────────────────────────────────────────────────────
def _rgb(h):
    h = h.lstrip("#")
    return tuple(int(h[i:i + 2], 16) / 255 for i in (0, 2, 4))

def _hex(r, g, b):
    return "#" + "".join(f"{max(0, min(255, round(x * 255))):02x}" for x in (r, g, b))

def _misto(a, b, t):
    a, b = _rgb(a), _rgb(b)
    return _hex(*(x + (y - x) * t for x, y in zip(a, b)))

def _luce(h):
    r, g, b = _rgb(h)
    return 0.2126 * r + 0.7152 * g + 0.0722 * b

def _contrasto(a, b):
    f = lambda x: x / 12.92 if x <= 0.03928 else ((x + 0.055) / 1.055) ** 2.4
    l = lambda h: (lambda r, g, b: 0.2126 * f(r) + 0.7152 * f(g) + 0.0722 * f(b))(*_rgb(h))
    la, lb = l(a), l(b)
    return (max(la, lb) + 0.05) / (min(la, lb) + 0.05)

def _leggibile(c, su, verso):
    """c, schiarito (o scurito) verso «verso» quanto basta perché su «su» si legga (contrasto 3:1)."""
    for i in range(11):
        m = _misto(c, verso, i / 10)
        if _contrasto(m, su) >= 3:
            return m
    return verso

def _qt(h, alfa):
    """#AARRGGBB, il formato di Qt per i colori con trasparenza."""
    return f"#{max(0, min(255, round(alfa * 255))):02x}{h.lstrip('#')}"

NOMI_COLORI = {"rosso": "#ff5a5a", "arancione": "#ff9a3c", "giallo": "#ffd43b", "oro": "#ffbf3f", "verde": "#6fd08c",
               "azzurro": "#7fd0ff", "blu": "#5b8cff", "viola": "#b18cff", "rosa": "#ff8ac2", "bianco": "#f4f6ff",
               "nero": "#0a0a0f", "grigio": "#9aa0ae"}


def _valido(chiave, v):
    """Il valore pulito, o ValueError con il motivo in italiano."""
    if chiave not in SCHEMA:
        raise ValueError(tr("chiave sconosciuta «%1» (possibili: %2)", chiave, ', '.join(SCHEMA)))
    tipo, _, lim, _ = SCHEMA[chiave]
    s = str(v).strip().lower() if not isinstance(v, (bool, int, float)) else v
    if tipo in ("colore", "colore_o_accento"):
        if tipo == "colore_o_accento" and s == "accento":
            return "accento"
        s = NOMI_COLORI.get(s, s)
        if isinstance(s, str) and re.fullmatch(r"#?[0-9a-f]{6}", s):
            return "#" + s.lstrip("#")
        raise ValueError(tr("%1: un colore come #7fd0ff (o un nome: %2)", chiave, ', '.join(NOMI_COLORI)))
    if tipo == "immagine":
        if s in ("", "nessuno", "nessuna", "niente"):
            return ""
        f = os.path.expanduser(str(v).strip())
        if not os.path.isfile(f) or not re.search(r"\.(png|jpe?g|webp|bmp)$", f, re.I):
            raise ValueError(tr("%1: un'immagine che esiste (png, jpg, webp)", chiave))
        return os.path.abspath(f)
    if tipo == "programma":
        import shutil
        nome = str(v).strip()
        if not re.fullmatch(r"[A-Za-z0-9._+-]+", nome) or not shutil.which(nome):
            raise ValueError(tr("%1: «%2» non è installato", chiave, nome))
        return nome
    if tipo == "scelta":
        if s in lim:
            return s
        raise ValueError(tr("%1: uno tra %2", chiave, ', '.join(lim)))
    if tipo == "tasti":
        if s in ("", "nessuno", "niente", "no"):
            return ""
        parti = [x.strip() for x in str(v).replace("-", "+").split("+") if x.strip()]
        mod = [MODIFICATORI.get(x.lower()) for x in parti[:-1]]
        if not parti or None in mod or parti[-1].lower() in MODIFICATORI:
            raise ValueError(tr("%1: una combinazione come «SUPER + I» (modificatori: SUPER, CTRL, ALT, SHIFT)", chiave))
        tasto = parti[-1]
        tasto = tasto.upper() if len(tasto) == 1 else tasto[:1].upper() + tasto[1:]
        return " + ".join(sorted(set(mod), key=["SUPER", "CTRL", "ALT", "SHIFT"].index) + [tasto])
    if tipo == "vero":
        if isinstance(s, bool):
            return s
        if s in ("1", "si", "sì", "yes", "true", "vero", "on"):
            return True
        if s in ("0", "no", "false", "falso", "off"):
            return False
        raise ValueError(tr("%1: sì o no", chiave))
    if tipo in ("intero", "numero"):
        try:
            n = float(s)
        except (TypeError, ValueError):
            raise ValueError(tr("%1: un numero tra %2 e %3", chiave, lim[0], lim[1]))
        if not lim[0] <= n <= lim[1]:
            raise ValueError(tr("%1: tra %2 e %3 (hai detto %4)", chiave, lim[0], lim[1], v))
        return int(round(n)) if tipo == "intero" else round(n, 2)
    if tipo == "font":
        nome = str(v).strip()
        fam = subprocess.run(["fc-list", ":", "family"], capture_output=True, text=True).stdout.lower()
        if nome.lower() not in {f.strip() for r in fam.splitlines() for f in r.split(",")}:
            raise ValueError(tr("il font «%1» non è installato", nome))
        return nome
    raise ValueError(chiave)


# ── file ──────────────────────────────────────────────────────────────────────────────────────────────────────
def leggi():
    try:
        d = json.loads(FILE.read_text())
        return {k: v for k, v in d.items() if k in SCHEMA}
    except (OSError, ValueError):
        return {}

def _scrivi_atomico(f, testo):
    f.parent.mkdir(parents=True, exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=f.parent, prefix=f".{f.name}.")
    with os.fdopen(fd, "w") as o:
        o.write(testo)
    os.replace(tmp, f)

def _istantanea():
    STORIA.mkdir(parents=True, exist_ok=True)
    (STORIA / f"{time.time_ns()}.json").write_text(json.dumps(leggi()))
    for vecchia in sorted(STORIA.glob("*.json"))[:-30]:      # le ultime 30 bastano
        vecchia.unlink()

def valore(scelte, k):
    if k == "opacita_pannelli" and k not in scelte:              # di serie: secondo la grafica (sfocata = più trasparente)
        # ma solo se la grafica di CielOS è davvero in uso (scelta, o la Hyprland di CielOS): con un'altra
        # configurazione la sfocatura può mancare, e un pannello trasparente senza sfocatura si legge male
        if "grafica" in scelte or HYPR_BASE.resolve() == (RADICE / "hypr/hyprland.lua").resolve() or os.environ.get("CIELOS_SESSIONE"):
            return OPACITA_GRAFICA[valore(scelte, "grafica")]
        return 0.96
    return scelte.get(k, SCHEMA[k][1])

OPACITA_GRAFICA = {"leggerissima": 0.96, "bilanciata": 0.86, "bella": 0.78}   # pannelli più trasparenti dove c'è la sfocatura
GRAFICA_LUA = RADICE / "hypr" / "grafica.lua"
HYPR_BASE = Path.home() / ".config" / "hypr" / "hyprland.lua"


def genera(scelte):
    """tema.json per la shell, hypr-ciel.lua per Hyprland, sddm.conf e (con tema_app) GTK e foot. True se Hyprland va ricaricato."""
    v = lambda k: valore(scelte, k)
    acc, fondo, testo = v("accento"), v("fondo"), v("testo")
    chiaro = _luce(fondo) > 0.5                                   # tema chiaro: le sfumature vanno verso il nero
    # l'accento resta quello scelto, ma mai illeggibile sul fondo (es. quasi nero su blu notte: titoli e cursore spariti)
    acc = _leggibile(acc, fondo, "#000000" if chiaro else testo)
    cambiati = lambda *ks: any(k in scelte for k in ks)
    # i colori derivati: calcolati solo se hai cambiato quelli da cui vengono, sennò quelli disegnati a mano
    tema = {
        "fondo": fondo,
        "fondoAlto": _misto(fondo, testo, 0.06) if cambiati("fondo", "testo") else "#141b3d",
        "superficie": _qt(_misto(fondo, "#000000" if not chiaro else "#ffffff", 0.35) if cambiati("fondo")
                          else "#0a0f29", v("opacita_pannelli")),
        "oro": acc,
        "oroChiaro": (_misto(acc, testo, 0.4) if not chiaro else _misto(acc, "#000000", 0.25))
                     if cambiati("accento", "testo", "fondo") else "#ffd98a",
        "testo": testo,
        "tenue": _misto(testo, fondo, 0.4) if cambiati("testo", "fondo") else "#9aa6c8",
        "allarme": v("allarme"),
        "bordo": _qt(acc, 0.3),
        "font": v("font"),
        "barra": v("barra_larghezza"),
        "raggio": v("raggio"),
        "margine": v("margine"),
        "animazioni": v("animazioni"),
        "spazi": not (scelte.get("spazio_dentro") == 0 and scelte.get("spazio_fuori") == 0),   # Strumenti: l'interruttore
        "blocco_dopo_s": v("blocco_minuti") * 60,
        "lato": v("barra_lato"),
        "sfondo": v("sfondo"),
        "suono_notifiche": v("suono_notifiche"),
        "avatar": v("avatar"),
        "terminale": v("terminale"),
    }
    _scrivi_atomico(TEMA, json.dumps(tema, indent=2, ensure_ascii=False) + "\n")

    hypr = _hypr(scelte, acc)
    prima = HYPR.read_text() if HYPR.exists() else ""
    if hypr != prima:
        _scrivi_atomico(HYPR, hypr)
    _scrivi_atomico(SDDM, "[General]\n" + "".join(f"{k}={tema[q]}\n" for k, q in
                    (("Font", "font"), ("Oro", "oro"), ("OroChiaro", "oroChiaro"), ("Testo", "testo"),
                     ("Tenue", "tenue"), ("Allarme", "allarme"), ("Fondo", "fondo"), ("FondoAlto", "fondoAlto"))))
    _app(v("tema_app"), tema, chiaro)
    _modo(v("modo"))
    # gli hook «tema» (cielos-hook): i tuoi script che seguono i colori (in sottofondo: non rallentano)
    subprocess.Popen([str(RADICE / "bin/cielos-hook"), "tema", acc], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    return hypr != prima


def _modo(modo):
    """Scuro o chiaro per tutte le app che lo chiedono al sistema (portale: browser, Electron, GTK4, Qt6)."""
    scuro = modo == "scuro"
    for chiave, val in (("color-scheme", "prefer-dark" if scuro else "prefer-light"),
                        ("gtk-theme", "adw-gtk3-dark" if scuro else "adw-gtk3")):
        subprocess.run(["gsettings", "set", "org.gnome.desktop.interface", chiave, val], capture_output=True, timeout=10)


def _hypr(scelte, acc):
    """Il file per Hyprland: le scorciatoie (sempre) e l'aspetto delle finestre (solo le chiavi scelte)."""
    righe = ["-- generato da cieltema dalle tue scelte in cielos.json: non modificarlo a mano", ""]
    if valore(scelte, "tasto_super"):
        righe.append('hl.bind("SUPER + SUPER_L", hl.dsp.global("ciel:lanciatore"), { release = true, description = "Super da solo: il lanciatore" })')
    for k, azione in TASTI.items():
        t = valore(scelte, k)
        if azione is None:                 # il terminale: il comando scelto
            azione = f'hl.dsp.exec_cmd("{valore(scelte, "terminale")}")'
        if t:                              # prima si toglie quella di caelestia sulla stessa combinazione
            righe.append(f'pcall(hl.unbind, "{t}")')
            d = SCHEMA[k][3].replace('"', "'")
            righe.append(f'hl.bind("{t}", {azione}, {{ description = "{d[:1].upper() + d[1:]}" }})')
    general, decoration = [], []
    if "finestre_bordo" in scelte:
        general.append(f"border_size = {scelte['finestre_bordo']}")
    if "spazio_dentro" in scelte:
        general.append(f"gaps_in = {scelte['spazio_dentro']}")
    if "spazio_fuori" in scelte:
        general.append(f"gaps_out = {scelte['spazio_fuori']}")
    # il bordo della finestra attiva: di serie l'accento (come la shell), se no il colore scelto
    c = acc if scelte.get("finestre_colore", "accento") == "accento" else scelte["finestre_colore"]
    general.append(f'col = {{ active_border = "rgba({c.lstrip("#")}e6)" }}')
    if "finestre_raggio" in scelte:
        decoration.append(f"rounding = {scelte['finestre_raggio']}")
    parti = []
    if general:
        parti.append("    general = { " + ", ".join(general) + " },")
    if decoration:
        parti.append("    decoration = { " + ", ".join(decoration) + " },")
    if parti:
        righe += ["", "hl.config({", *parti, "})"]
    # la grafica scelta (animazioni, ombre, sfocature: hypr/grafica.lua); senza scelta resta quella della base
    if "grafica" in scelte:
        righe += ["", f'dofile("{GRAFICA_LUA}")("{scelte["grafica"]}")']
    # i pannelli di Ciel sfocano quello che hanno sotto (se la sfocatura di Hyprland è accesa; se no non costa niente)
    righe += ["", 'hl.layer_rule({ match = { namespace = "ciel-(barra|lanciatore|riquadro|impostazioni|centro|notifiche|osd|'
                  'sessione|polkit|casella)" }, blur = true, ignore_alpha = 0.3 })']
    # le Impostazioni di sistema (schermi, tastiera e mouse, avanzate: cielimposta), se non le carica già la base
    # di CielOS (che le legge da sé): così valgono anche con un'altra configurazione di Hyprland
    righe += ["", 'local _s = os.getenv("HOME") .. "/.config/cielos/hypr-sistema.lua"',
              'if not CIELOS_BASE then local f = io.open(_s, "r"); if f then f:close(); dofile(_s) end end']
    # le app di Ciel si aprono flottanti e centrate: aprirle non rimescola le finestre (si affiancano con il solito tasto)
    righe += ["", 'hl.window_rule({ match = { title = "^Ciel Codice$" }, float = true, '
                  'size = "(monitor_w*0.7) (monitor_h*0.8)", center = true })',
              # il terminale delle installazioni dei plugin: flottante, centrato, davanti
              'hl.window_rule({ match = { class = "^cielplugin$" }, float = true, '
              'size = "(monitor_w*0.55) (monitor_h*0.6)", center = true })']
    return "\n".join(righe) + "\n"


SEGNO_APP = "/* generato da cieltema (tema_app): l'originale è in gtk.css.prima-di-ciel */"

def _app(attivo, t, chiaro):
    """I colori e gli angoli di Ciel nelle app GTK, in foot e in CielFox; spento, rimette i file com'erano."""
    r = t["raggio"]
    # CielFox (il browser) legge questo file: il profilo lo copia in chrome/ciel.css (bin/cielfox)
    if attivo:
        _scrivi_atomico(CONF / "cielfox.css",
                        "/* generato da cieltema (tema_app): le forme di CielOS nel browser */\n"
                        f":root {{ --ciel-raggio: {r}px; --ciel-accento: {t['oro']}; --ciel-fondo: {t['fondo']};\n"
                        f"         --ciel-testo: {t['testo']}; --ciel-tenue: {t['tenue']}; }}\n")
    elif (CONF / "cielfox.css").exists():
        (CONF / "cielfox.css").unlink()
    for f in GTK:
        copia = f.with_name("gtk.css.prima-di-ciel")
        nostro = f.exists() and f.read_text().startswith(SEGNO_APP)
        if attivo:
            if f.exists() and not nostro:
                f.replace(copia)
            superf = _misto(t["fondo"], "#000000" if not chiaro else "#ffffff", 0.35)
            colori = {"accent_color": t["oro"], "accent_bg_color": t["oro"], "accent_fg_color": t["fondo"],
                      "window_bg_color": t["fondo"], "window_fg_color": t["testo"],
                      "headerbar_bg_color": t["fondoAlto"], "headerbar_fg_color": t["testo"],
                      "popover_bg_color": t["fondoAlto"], "popover_fg_color": t["testo"],
                      "view_bg_color": superf, "view_fg_color": t["testo"],
                      "card_bg_color": t["fondoAlto"], "card_fg_color": t["testo"],
                      "sidebar_bg_color": t["fondoAlto"], "sidebar_fg_color": t["testo"],
                      "dialog_bg_color": t["fondoAlto"], "dialog_fg_color": t["testo"],
                      "destructive_color": t["allarme"], "error_color": t["allarme"],
                      "theme_selected_bg_color": t["oro"], "theme_selected_fg_color": t["fondo"],
                      "theme_bg_color": t["fondo"], "theme_fg_color": t["testo"],
                      "theme_base_color": superf, "theme_text_color": t["testo"]}
            f.parent.mkdir(parents=True, exist_ok=True)       # su un PC nuovo la cartella non c'è ancora
            # stessi angoli della shell (con «pixel» sono 0: anche i pulsanti e le finestre delle app si squadrano)
            angoli = (f"\n/* gli angoli di CielOS ({r}px) */\n"
                      "window, .background, headerbar, button, entry, spinbutton, popover, card, .card, menu, menuitem,\n"
                      "dropdown, notebook > header > tabs > tab, scale slider { border-radius: " f"{r}px; }}\n")
            _scrivi_atomico(f, SEGNO_APP + "\n" + "".join(f"@define-color {k} {c};\n" for k, c in colori.items()) + angoli)
        elif nostro:
            if copia.exists():
                copia.replace(f)
            else:
                f.unlink()
    if attivo and not FOOT.exists():                     # su un PC nuovo: un foot.ini di CielOS da cui partire
        FOOT.parent.mkdir(parents=True, exist_ok=True)
        _scrivi_atomico(FOOT, "# foot in CielOS (cambialo pure: i colori li aggiunge cieltema con la riga include)\n"
                              "font=JetBrainsMono Nerd Font:size=11\npad=10x8\n")
    if FOOT.exists():
        testo = FOOT.read_text()
        riga = f"include={FOOT_CIEL}"
        if attivo:
            sezione = "colors-light" if chiaro else "colors-dark"
            _scrivi_atomico(FOOT_CIEL, f"# generato da cieltema (tema_app)\n[{sezione}]\n"
                            f"background={t['fondo'].lstrip('#')}\nforeground={t['testo'].lstrip('#')}\n"
                            f"selection-background={t['oro'].lstrip('#')}\nselection-foreground={t['fondo'].lstrip('#')}\n"
                            f"cursor={t['fondo'].lstrip('#')} {t['oro'].lstrip('#')}\n"
                            f"regular4={_misto(t['oro'], '#5b8cff', 0.6).lstrip('#')}\nregular3={t['oro'].lstrip('#')}\n"
                            f"bright3={t['oroChiaro'].lstrip('#')}\nregular1={t['allarme'].lstrip('#')}\n")
            if riga not in testo:              # in cima: include va nella sezione principale
                _scrivi_atomico(FOOT, f"# i colori di Ciel (cieltema, tema_app)\n{riga}\n" + testo)
        elif riga in testo:
            _scrivi_atomico(FOOT, testo.replace(f"# i colori di Ciel (cieltema, tema_app)\n{riga}\n", "").replace(riga + "\n", ""))


def applica(nuove, istantanea=True):
    """Salva le scelte (dopo l'istantanea), genera i file, ricarica Hyprland se serve. Le differenze, in italiano."""
    vecchie = leggi()
    if istantanea and nuove != vecchie:
        _istantanea()
    _scrivi_atomico(FILE, json.dumps(nuove, indent=2, ensure_ascii=False) + "\n")
    if genera(nuove):
        subprocess.run(["hyprctl", "reload"], capture_output=True, timeout=10)
    return differenze(vecchie, nuove)

def differenze(a, b):
    out = []
    for k in SCHEMA:
        x, y = valore(a, k), valore(b, k)
        if x != y:
            out.append(f"{k} {_dici(x)} → {_dici(y)}")
    return out

def _dici(v):
    return tr("di serie") if v is None else tr("nessuno") if v == "" else (tr("sì") if v is True else tr("no") if v is False else str(v))


# ── colori dallo sfondo ───────────────────────────────────────────────────────────────────────────────────────
def sfondo_attuale():
    """Il file dello sfondo che c'è adesso: mpvpaper (video), poi quello scelto in caelestia, poi hyprpaper."""
    r = subprocess.run(["pgrep", "-a", "mpvpaper"], capture_output=True, text=True).stdout.split()
    if r and os.path.isfile(r[-1]):
        return r[-1]
    p = Path.home() / ".local/state/caelestia/wallpaper/path.txt"
    if p.exists() and os.path.isfile(p.read_text().strip()):
        return p.read_text().strip()
    conf = Path.home() / ".config/hypr/hyprpaper.conf"
    if conf.exists():
        m = re.search(r"(?m)^\s*wallpaper\s*=\s*[^,]*,\s*(.+)$", conf.read_text())
        if m and os.path.isfile(os.path.expanduser(m.group(1).strip())):
            return os.path.expanduser(m.group(1).strip())
    return None

def colori_da(file):
    from PIL import Image
    tmp = None
    if re.search(r"\.(mp4|webm|mkv|mov|gif)$", file, re.I):          # un video: un fotogramma dopo 2 secondi
        tmp = tempfile.mktemp(suffix=".png")
        subprocess.run(["ffmpeg", "-loglevel", "error", "-ss", "2", "-i", file, "-frames:v", "1", tmp], timeout=30)
        file = tmp
    try:
        img = Image.open(file).convert("RGB")
        img.thumbnail((96, 96))
        q = img.quantize(10)
        pal = q.getpalette()
        conti = sorted(q.getcolors(), reverse=True)
    finally:
        if tmp and os.path.exists(tmp):
            os.unlink(tmp)
    tot = sum(c for c, _ in conti)
    colori = [(c / tot, tuple(pal[i * 3 + j] / 255 for j in range(3))) for c, i in conti]
    # il fondo: la tinta più presente, scurita
    _, dom = colori[0]
    h, l, s = colorsys.rgb_to_hls(*dom)
    fondo = _hex(*colorsys.hls_to_rgb(h, 0.08, min(s, 0.55)))
    # l'accento: il colore più vivo tra quelli non rari, reso luminoso
    def vivo(x):
        q, c = x
        _, ll, ss = colorsys.rgb_to_hls(*c)
        return ss * (1 - abs(ll - 0.55)) * (q ** 0.3)
    _, viv = max(colori, key=vivo)
    h2, l2, s2 = colorsys.rgb_to_hls(*viv)
    acc = _hex(*colorsys.hls_to_rgb(h2, max(0.6, min(l2, 0.7)), max(s2, 0.65)))
    testo = _hex(*colorsys.hls_to_rgb(h2, 0.95, 0.5))
    return {"accento": acc, "fondo": fondo, "testo": testo}


# ── comandi ───────────────────────────────────────────────────────────────────────────────────────────────────
def esegui(args):
    """(ok, messaggio, dati) per ogni comando."""
    cmd, resto = (args[0], args[1:]) if args else ("mostra", [])
    if cmd in ("aiuto", "help", "-h", "--help", "--aiuto"):
        return True, tr(__doc__), {}
    scelte = leggi()
    if cmd == "mostra":
        return True, "\n".join(f"{k} = {_dici(valore(scelte, k))}{'' if k in scelte else '  ' + tr('(di serie)')}" for k in SCHEMA), \
            {k: valore(scelte, k) for k in SCHEMA}
    if cmd == "schema":
        # «titolo»: le poche voci che nelle Impostazioni vogliono un nome corto invece della descrizione intera
        d = {k: {"tipo": t, "di_serie": s, "limiti": l, "cosa": tr(c),
                 **(({"titolo": tr(TITOLI[k])} if k in TITOLI else {})),
                 **(({"dettagli": {n: tr(x) for n, x in PRESET_DETTAGLI.items()}} if k == "preset" else {}))}
             for k, (t, s, l, c) in SCHEMA.items()}
        testo = "\n".join(f"{k}: {tr(c)} ({t}{f', {l[0]}-{l[1]}' if l else ''}; {tr('di serie')} {_dici(s)})"
                          for k, (t, s, l, c) in SCHEMA.items())
        return True, testo + "\n" + tr("Temi pronti: ") + ", ".join(TEMI), {"chiavi": d, "temi": list(TEMI)}
    if cmd == "imposta":
        nuove, errori = dict(scelte), []
        for a in resto:
            if "=" not in a:
                errori.append(tr("«%1»: serve chiave=valore", a))
                continue
            k, v = a.split("=", 1)
            try:
                nuove[k.strip()] = _valido(k.strip(), v)
            except ValueError as e:
                errori.append(str(e))
        usati = {}
        for k in TASTI:
            t = valore(nuove, k)
            if t and t in usati:
                errori.append(tr("«%1» è già di %2", t, usati[t]))
            usati[t] = k
        if errori:
            return False, "; ".join(errori), {"errori": errori}
        # un preset nuovo porta con sé il suo pacchetto; le chiavi chieste nella stessa riga vincono
        if "preset" in nuove and nuove["preset"] != valore(scelte, "preset"):
            esplicite = {a.split("=", 1)[0].strip() for a in resto if "=" in a}
            for k, x in pacchetto(nuove["preset"]).items():
                if k in esplicite:
                    continue
                if x is None:
                    nuove.pop(k, None)
                else:
                    nuove[k] = x
        d = applica(nuove)
        return True, (tr("Cambiato: ") + "; ".join(d)) if d else tr("Era già così."), {"cambiato": d}
    if cmd == "preset":
        if not resto:
            attivo = valore(scelte, "preset")
            righe = [f"{n}{'  ←' if n == attivo else ''}" for n in PRESET]
            return True, tr("Preset: ") + ", ".join(righe), {"preset": list(PRESET), "attivo": attivo}
        nome = resto[0].strip().lower()
        if nome not in PRESET:
            return False, tr("Preset sconosciuto: %1 (ci sono: %2)", resto[0], ', '.join(PRESET)), {}
        nuove = dict(scelte) | {"preset": nome}
        for k, x in pacchetto(nome).items():
            if x is None:
                nuove.pop(k, None)
            else:
                nuove[k] = x
        d = applica(nuove)
        return True, (tr("Preset «%1»: ", nome) + "; ".join(d) if d else tr("Era già così.")), {"cambiato": d, "preset": nome}
    if cmd == "togli":
        nuove = {k: v for k, v in scelte.items() if k not in resto}
        if "preset" in resto:                      # togliere il preset toglie anche quello che aveva regolato
            for k in _CHIAVI_PRESET:
                nuove.pop(k, None)
        d = applica(nuove)
        return True, (tr("Di serie: ") + "; ".join(d)) if d else tr("Era già di serie."), {"cambiato": d}
    if cmd == "tema":
        if not resto:
            return True, tr("Temi: ") + ", ".join(TEMI), {"temi": list(TEMI)}
        t = TEMI.get(resto[0].lower())
        if t is None:
            return False, tr("Non c'è il tema «%1» (ci sono: %2)", resto[0], ', '.join(TEMI)), {}
        nuove = {k: v for k, v in scelte.items() if k not in COLORI} | t
        d = applica(nuove)
        return True, tr("Tema «%1». ", resto[0].lower()) + ("; ".join(d) if d else tr("Era già questo.")), {"cambiato": d}
    if cmd == "sfondo":
        f = resto[0] if resto else sfondo_attuale()
        if not f or not os.path.isfile(f):
            return False, tr("Non trovo lo sfondo: dimmi il file."), {}
        try:
            c = colori_da(f)
        except Exception as e:
            return False, tr("Non riesco a leggere i colori di %1: %2", os.path.basename(f), e), {}
        d = applica({k: v for k, v in scelte.items() if k not in COLORI} | c)
        return True, tr("Colori presi da %1: ", os.path.basename(f)) + ("; ".join(d) if d else tr("erano già questi.")), \
            {"cambiato": d, "file": f}
    if cmd == "annulla":
        foto = sorted(STORIA.glob("*.json")) if STORIA.exists() else []
        if not foto:
            return False, tr("Non c'è niente da annullare."), {}
        prima = json.loads(foto[-1].read_text())
        foto[-1].unlink()
        d = applica(prima, istantanea=False)
        return True, (tr("Tornato com'era: ") + "; ".join(d)) if d else tr("Era già così."), {"cambiato": d}
    if cmd == "ripristina":
        d = applica({})
        return True, (tr("Tutto di serie: ") + "; ".join(d)) if d else tr("Era già tutto di serie."), {"cambiato": d}
    if cmd == "genera":                      # rigenera i file senza cambiare niente (dopo un aggiornamento)
        if genera(scelte):
            subprocess.run(["hyprctl", "reload"], capture_output=True, timeout=10)
        return True, tr("Rigenerati i file di Ciel (tema.json, hypr-ciel.lua, sddm.conf)."), {}
    return False, tr(__doc__), {}


if __name__ == "__main__":
    a = [x for x in sys.argv[1:] if x != "--json"]
    ok, msg, dati = esegui(a)
    if "--json" in sys.argv:
        print(json.dumps({"ok": ok, "messaggio": msg, **dati}, ensure_ascii=False))
    else:
        print(msg)
    sys.exit(0 if ok else 1)
