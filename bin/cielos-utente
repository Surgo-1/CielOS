#!/bin/bash
# Prepara il tuo utente per CielOS (la sessione lo lancia a ogni accesso: rifà solo quello che manca, in un attimo).
# Le cartelle dell'utente, la shell Ciel attiva, i colori e le scorciatoie (cieltema), la scelta del terminale.
set -u
# la guida prima di tutto: senza, «cielos-utente --aiuto» non stampava niente e preparava l'utente per davvero
case "${1:-}" in aiuto|--aiuto|-h|help) awk 'NR>1 && /^#/ { sub(/^# ?/, ""); print; next } NR>1 { exit }' "$0"; exit 0 ;; esac
R=${CIELOS_DIR:-$(dirname "$(readlink -f "$0")")/..}
C=${XDG_CONFIG_HOME:-$HOME/.config}/cielos
mkdir -p "$C"
if [ ! -f "$C/.preparato" ]; then
    xdg-user-dirs-update 2>/dev/null
    touch "$C/shell-attiva"
    [ -f "$C/cielos.json" ] || echo '{}' > "$C/cielos.json"
    "$R/bin/cieltema" genera >/dev/null 2>&1
    xdg-mime default ciel-file.desktop inode/directory 2>/dev/null       # le cartelle si aprono con File
    touch "$C/.preparato"
    echo "$(date '+%F %T') utente preparato"
fi
# le impostazioni di sistema scelte nell'installatore (tastiera…): hypr-sistema.lua
[ -f "$C/sistema.json" ] && [ ! -f "$C/hypr-sistema.lua" ] && "$R/bin/cielimposta" genera >/dev/null 2>&1
# se cieltema non ha ancora scritto i file, o un aggiornamento ha cambiato i valori di serie (es. un tasto), li rigenera
[ -f "$C/tema.json" ] && [ -f "$C/hypr-ciel.lua" ] && [ ! "$R/bin/cieltema" -nt "$C/hypr-ciel.lua" ] \
    || "$R/bin/cieltema" genera >/dev/null 2>&1
# la modalità gioco (un'automazione di cield): di serie, una volta sola (se la togli non torna)
if [ ! -f "$C/.gioco-messa" ]; then
    mkdir -p "$C/automazioni"
    [ -f "$C/automazioni/modalita-gioco.toml" ] || cp "$R/automazioni/esempi/modalita-gioco.toml" "$C/automazioni/"
    touch "$C/.gioco-messa"
fi
# i microfoni USB che all'avvio partono «solo uscita» (es. RØDE NT-USB): rimette il profilo col microfono (uno solo)
setsid flock -n "${XDG_RUNTIME_DIR:-/tmp}/cielos-microfono.lock" "$R/bin/cielos-microfono" segui >/dev/null 2>&1 &
"$R/bin/cielos-hook" accesso &
exit 0
