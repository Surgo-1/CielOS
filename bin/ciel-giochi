#!/bin/sh
# CielGiochi: i giochi di Steam, con ProtonDB e l'anti-cheat su Linux dentro CielOS.
#   ciel-giochi            apre la finestra di CielGiochi
#   ciel-giochi APPID     la apre già sul gioco indicato
# Il lavoro (librerie di Steam, ProtonDB, requisiti) lo fa cielgiochi.
case "${1:-}" in aiuto|--aiuto|-h|help) awk 'NR>1 && /^#/ { sub(/^# ?/, ""); print; next } NR>1 { exit }' "$0"; exit 0 ;; esac
R=${CIELOS_DIR:-$(dirname "$(readlink -f "$0")")/..}
CIEL_GIOCHI_SCELTO="${1:-}" exec qs -n -p "$R/app/giochi"
