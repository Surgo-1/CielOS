#!/usr/bin/env bash
# CielAI - AI System Status & Control
# Shows AI model status, performs diagnostics, manages resources

set -euo pipefail

# Colors
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
RED='\033[0;31m'
NC='\033[0m'

log() { echo "$*"; }
success() { log "${GREEN}✓${NC} $*"; }
warn() { log "${YELLOW}!${NC} $*"; }
error() { log "${RED}✗${NC} $*" >&2; }

show_status() {
    echo -e "\n${BLUE}════════════════════════════════════════${NC}"
    echo -e "${BLUE}    CielOS AI System Status${NC}"
    echo -e "${BLUE}════════════════════════════════════════${NC}\n"
    
    # GPU Status
    if command -v nvidia-smi &>/dev/null; then
        echo "GPU Status:"
        nvidia-smi --query-gpu=name,memory.total,memory.used,memory.free,utilization.gpu \
            --format=csv,noheader,nounits | \
            while IFS=',' read -r name total used free util; do
                echo "  Name: $(echo "$name" | xargs)"
                echo "  VRAM: ${used}MB / ${total}MB used (${util}% utilized)"
            done
        echo ""
    else
        echo "GPU Status: Not detected or NVIDIA driver unavailable"
        echo ""
    fi
    
    # CPU Status
    echo "CPU Status:"
    echo "  Cores: $(nproc)"
    echo "  Load: $(uptime | awk -F'load average:' '{print $2}' | xargs)"
    echo "  RAM: $(free -h | awk '/^Mem:/{print $3" / "$2}')"
    echo ""
    
    # AI Software Status
    echo "AI Software:"
    
    # Ollama
    if command -v ollama &>/dev/null; then
        if ollama list 2>/dev/null | grep -q .; then
            echo "  Ollama: Installed"
            echo "  Models available:"
            ollama list 2>/dev/null | tail -n +2 | while read -r line; do
                echo "    - $line"
            done
        else
            echo "  Ollama: Installed, no models"
        fi
    else
        echo "  Ollama: Not installed"
    fi
    echo ""
    
    # DeepSeek V4.1 Flash
    local model_path="${HOME}/.local/share/cielos/models/deepseek-v4.1-flash.gguf"
    if [ -f "$model_path" ]; then
        local size=$(du -h "$model_path" | cut -f1)
        echo "  DeepSeek V4.1 Flash: Available (${size})"
        local vram_needed=$((7 * 1000))  # ~7GB FP16, ~2GB Q2_K
        echo "  VRAM needed (Q2_K): ~2GB"
    else
        echo "  DeepSeek V4.1 Flash: Not found"
        echo "  Install with: cielquant compress deepseek-v4.1-flash --bits 2 --level aggressive"
    fi
    echo ""
    
    # GTX 1650 Optimizations
    echo "GTX 1650 Optimizations:"
    echo "  Quantization: Q2_K (2-bit) enabled by default"
    echo "  CPU offload: Active (layers 33-74 offloaded)"
    echo "  SSD cache: ~/.cache/cielos/model_layers"
    echo "  KV cache: Optimized to 2048 tokens max"
    echo ""
}

run_diagnostics() {
    echo -e "\n${BLUE}Running AI Diagnostics...${NC}\n"
    
    # Check VRAM
    local vram_available=$(nvidia-smi --query-gpu=memory.free --format=csv,noheader,nounits 2>/dev/null | head -1 | xargs || echo "0")
    local vram_needed=2000  # Q2_K for 7B model
    
    echo "VRAM Check:"
    if [ "$vram_available" -ge "$vram_needed" ]; then
        success "Sufficient VRAM: ${vram_available}MB available"
    else
        warn "Limited VRAM: ${vram_available}MB available, ${vram_needed}MB needed"
        warn "CPU offload will be used"
    fi
    
    # Check SSD cache
    local cache_path="${HOME}/.cache/cielos"
    if [ -d "$cache_path" ]; then
        local cache_size=$(du -sh "$cache_path" 2>/dev/null | cut -f1 || echo "unknown")
        echo "SSD Cache: Available ($cache_size)"
    else
        warn "SSD Cache: Not found"
    fi
    
    # Check CPU
    local cpu_count=$(nproc)
    if [ "$cpu_count" -ge 6 ]; then
        success "CPU: ${cpu_count} cores available for offload"
    else
        warn "CPU: Limited cores (${cpu_count}) for offload"
    fi
}

show_hardware_profile() {
    local profile=$1
    echo -e "\n${BLUE}Hardware Profile: $profile${NC}\n"
    
    case $profile in
        gtx-1650)
            cat << EOF
Optimized settings for GTX 1650 4GB:
  - Model: Q2_K quantized (2-bit)
  - VRAM: ~2GB model weights, ~0.5GB KV cache
  - CPU: Offload layers 33-74
  - Context: 2048 tokens max
  - Batch: 32
  - Expected speed: ~5 tokens/sec
  - SSD cache: Enabled for overflow
EOF
            ;;
        rtx-40xx)
            cat << EOF
Optimized settings for RTX 40xx:
  - Model: Q4_K_M quantized (4-bit)
  - VRAM: Full model + large context
  - Tensor cores: Enabled
  - Context: 8192-32768 tokens
  - Batch: 128-256
  - Expected speed: ~30-50 tokens/sec
  - Flash Attention: Enabled
EOF
            ;;
        cpu-only)
            cat << EOF
Optimized settings for CPU-only:
  - Model: Q3_K_M quantized (3-bit)
  - CPU threads: All available
  - Context: 4096 tokens max
  - Batch: 16-32
  - SSD cache: Aggressive paging
  - Expected speed: ~2-10 tokens/sec
EOF
            ;;
        *)
            show_status
            ;;
    esac
}

# Main
case "${1:-}" in
    status|--status|-s)
        show_status
        ;;
    diagnostics|--diagnostics|-d)
        run_diagnostics
        ;;
    profile|--profile|-p)
        show_hardware_profile "${2:-auto}"
        ;;
    *)
        cat << EOF
CielAI - AI System Management

Usage: cielai [command]

Commands:
  status     Show current AI system status
  diagnostics  Run hardware and software diagnostics
  profile    Show hardware-specific optimizations

Examples:
  cielai status
  cielai diagnostics
  cielai profile gtx-1650
EOF
        ;;
esac