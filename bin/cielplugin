#!/usr/bin/env python3
"""I plugin di CielOS (come il menu Installa di Omarchy): giochi, sviluppo, web app, programmi da terminale,
servizi, comunicazione, grafica, ufficio. Il catalogo è in plugin/catalogo.json; quelli installati in
~/.config/cielos/plugin.json. Ogni installazione gira in un terminale: vedi cosa fa, e la password la scrivi tu.

  cielplugin                     il catalogo (con ✓ quelli installati)
  cielplugin elenco --json       lo stesso, per le Impostazioni
  cielplugin installa ID…        installa (in un terminale nuovo se non sei già in uno; --qui per farlo qui)
  cielplugin togli ID…           toglie (i pacchetti che servono ad altro restano)
  cielplugin webapp NOME URL     una web app tua: una finestra sola per quel sito, nel menu delle app
  cielplugin script ID           lo script che userebbe (per guardarlo prima)

Install (il riquadro, Super+A), come Shelly: tutte le fonti insieme.
  cielplugin cerca TESTO [--json]          repository di Arch, AUR (anche -git e -bin) e Flathub, raggruppati per programma
  cielplugin versioni repo|flatpak NOME    le versioni che si possono scegliere (Arch: anche le vecchie, dall'archivio)
  cielplugin pacchetto FONTE NOME [VER]    installa quella variante (repo, aur, flatpak), anche una versione precisa
  cielplugin installati TESTO [--json]     tutto quello che è installato e contiene quelle lettere
  cielplugin rimuovi FONTE:NOME…           toglie (mai i pacchetti vitali; quelli che servono ad altro restano)
  cielplugin aggiorna-tutto                sistema (con le ondate e l'istantanea), AUR e Flatpak

Gli hook (come quelli di Omarchy): file eseguibili in ~/.config/cielos/hooks/EVENTO/, lanciati da cielos-hook
negli eventi tema (colori cambiati), accesso (all'accesso), plugin (ID installato). Per tutti gli altri eventi del
PC (giochi, chiavette, rete, aggiornamenti…) ci sono le automazioni di cield."""
import json, os, re, shlex, shutil, subprocess, sys, time, urllib.parse, urllib.request
from pathlib import Path

RADICE = Path(os.environ.get("CIELOS_DIR") or Path(__file__).resolve().parent.parent)
CATALOGO = RADICE / "plugin" / "catalogo.json"
sys.path.insert(0, str(RADICE / "lingua"))
from lingua import LINGUA, tr
CONF = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config")) / "cielos"
STATO = CONF / "plugin.json"
APPS = Path(os.environ.get("XDG_DATA_HOME", Path.home() / ".local/share")) / "applications"
WEBAPP = Path(os.environ.get("XDG_DATA_HOME", Path.home() / ".local/share")) / "cielos" / "webapp"


def catalogo():
    """il catalogo; in un'altra lingua nomi delle categorie, descrizioni e note da catalogo.LINGUA.json (se ci sono)"""
    c = json.loads(CATALOGO.read_text())
    if LINGUA != "it":
        try:
            t = json.loads(CATALOGO.with_suffix(f".{LINGUA}.json").read_text())
        except (OSError, ValueError):
            return c
        for k, nome in t.get("categorie", {}).items():
            if k in c["categorie"]:
                c["categorie"][k][1] = nome
        for pl in c["plugin"]:
            pl.update(t.get("plugin", {}).get(pl["id"], {}))
    return c


def stato():
    try:
        return json.loads(STATO.read_text())
    except (OSError, ValueError):
        return {"installati": {}, "webapp": {}}


def salva(s):
    CONF.mkdir(parents=True, exist_ok=True)
    STATO.write_text(json.dumps(s, indent=2, ensure_ascii=False))


_INSTALLATI = None


def installato_pkg(p):
    """con una sola lettura di tutti i pacchetti (pacman -Qq), non una per pacchetto"""
    global _INSTALLATI
    if _INSTALLATI is None:
        _INSTALLATI = set(subprocess.run(["pacman", "-Qq"], capture_output=True, text=True).stdout.split())
    return p in _INSTALLATI


_FLATPAK = None


def installato_flatpak(app):
    """una sola lettura: flatpak list (dell'utente e di sistema)"""
    global _FLATPAK
    if _FLATPAK is None:
        try:
            _FLATPAK = set(subprocess.run(["flatpak", "list", "--app", "--columns=application"], capture_output=True,
                                          text=True, timeout=20).stdout.split())
        except (OSError, subprocess.TimeoutExpired):
            _FLATPAK = set()
    return app in _FLATPAK


def fonte(pl):
    """da dove arriva: arch (repository ufficiali), flathub, aur"""
    return "flathub" if pl.get("flatpak") else "aur" if pl.get("aur") else "arch"


def pacchetti_di(pl):
    if pl.get("pacchetti_da") == "cielmodelli motore":
        try:
            r = json.loads(subprocess.run([str(RADICE / "bin/cielmodelli"), "motore", "--json"], capture_output=True, text=True).stdout)
            return r.get("pacchetti", ["ollama"])
        except (OSError, ValueError):
            return ["ollama"]
    return pl.get("pacchetti", [])


def e_installato(pl, s):
    if pl["id"] in s["installati"]:
        return True
    if pl.get("flatpak"):
        return installato_flatpak(pl["flatpak"])
    pk = pacchetti_di(pl) + pl.get("aur", [])
    if pl.get("webapp") and not pk:
        return (APPS / f"cielos-webapp-{pl['id']}.desktop").exists()
    return bool(pk) and all(installato_pkg(p) for p in pk)


def q(x):
    return shlex.quote(str(x))


def qd(x):
    """le virgolette delle voci .desktop (la specifica vuole quelle doppie, non le singole della shell)"""
    x = str(x)
    if re.fullmatch(r"[A-Za-z0-9_./:%@+=-]+", x):
        return x
    return '"' + re.sub(r'(["`$\\])', r"\\\1", x) + '"'


# prima di ogni pacman: se un altro sta lavorando (un altro plugin, Ciel che si installa, un aggiornamento) aspetta
# che finisca; se il blocco è rimasto ma nessun pacman gira (spento a metà), lo toglie
ASPETTA_PACMAN = r"""aspetta_pacman() {
  local n=0
  while [ -e /var/lib/pacman/db.lck ]; do
    if ! ps -C pacman,pacstrap,paru,yay,pamac >/dev/null; then
      sleep 2
      if [ -e /var/lib/pacman/db.lck ] && ! ps -C pacman,pacstrap,paru,yay,pamac >/dev/null; then
        echo @BLOCCATO@
        sudo rm -f /var/lib/pacman/db.lck
      fi
      continue
    fi
    [ $n = 0 ] && echo @ASPETTO@
    n=$((n + 1)); [ $n -gt 600 ] && { echo @NON_FINISCE@; return 1; }
    sleep 1
  done
}"""


def aspetta():
    """la funzione bash aspetta_pacman, con i messaggi nella lingua di CielOS"""
    return (ASPETTA_PACMAN.replace("@BLOCCATO@", q("   " + tr("pacman era rimasto bloccato (nessuna installazione in corso): tolgo il blocco")))
            .replace("@ASPETTO@", q("   " + tr("aspetto che finisca un'altra installazione…")))
            .replace("@NON_FINISCE@", q("   " + tr("l'altra installazione non finisce: riprova più tardi"))))


# paru (per l'AUR): se manca lo compila una volta (paru-bin), poi i pacchetti dell'AUR passano da lui
PARU = ("if ! command -v paru >/dev/null; then sudo pacman -S --needed --noconfirm base-devel git; "
        "d=$(mktemp -d) && git clone https://aur.archlinux.org/paru-bin.git \"$d/paru-bin\" && "
        "(cd \"$d/paru-bin\" && makepkg -si --noconfirm); rm -rf \"$d\"; fi")


def script(pl, togli=False):
    """lo script bash dell'installazione (o della rimozione)"""
    r = ["set -e", aspetta(), f"echo {q('── ' + pl['nome'] + ': ' + (tr('tolgo') if togli else tr('installo')))}"]
    pk = pacchetti_di(pl)
    if togli:
        for sv in pl.get("servizi", []):
            r.append(f"sudo systemctl disable --now {q(sv)} || true")
        for sv in pl.get("servizi_utente", []):
            r.append(f"systemctl --user disable --now {q(sv)} || true")
        if pl.get("flatpak"):
            r.append(f"flatpak uninstall --user -y --noninteractive {q(pl['flatpak'])} || flatpak uninstall -y --noninteractive {q(pl['flatpak'])}")
        da_togliere = pl.get("togli_pacchetti", pk + pl.get("aur", []))
        if da_togliere:
            r.append("aspetta_pacman")
            r.append("for p in " + " ".join(map(q, da_togliere)) + "; do pacman -Q \"$p\" >/dev/null 2>&1 && "
                     "{ sudo pacman -Rns --noconfirm \"$p\" || echo \"   $p: \"" + q(tr("serve ad altro: resta")) + "; }; done")
        for d in (f"cielos-webapp-{pl['id']}.desktop", f"cielos-tui-{pl['id']}.desktop"):
            r.append(f"rm -f {q(APPS / d)}")
        r.append(f"rm -rf {q(WEBAPP / pl['id'])}")
        return "\n".join(r)
    if pl.get("flatpak"):
        r.append("echo " + q("   " + tr("Da Flathub: il programma gira isolato dal sistema (Flatpak).")))
        r.append("aspetta_pacman")
        r.append("command -v flatpak >/dev/null || sudo pacman -S --needed --noconfirm flatpak")
        r.append("flatpak remote-add --user --if-not-exists flathub https://dl.flathub.org/repo/flathub.flatpakrepo")
        r.append(f"flatpak install --user -y --noninteractive flathub {q(pl['flatpak'])}")
        r.append("echo " + q("   " + tr("(se non lo vedi subito nel menu delle app, esci e rientra una volta)")))
    if pl.get("aur"):
        r.append("echo " + q("   " + tr("Dall'AUR: una ricetta della comunità, Arch non la controlla. Si compila sul tuo PC.")))
        r.append("aspetta_pacman")
        r.append(PARU)
        r.append("aspetta_pacman")
        r.append("paru -S --needed --noconfirm --skipreview " + " ".join(map(q, pl["aur"])))
    if pl.get("rischio") and not pl.get("aur"):
        r.append("echo " + q("   " + tr("Attenzione: arriva da fuori dai repository di Arch (nessun controllo di Arch).")))
    if pl.get("multilib"):
        # multilib (programmi a 32 bit): acceso come gli altri repository; con le ondate segue la stessa ondata
        r.append("aspetta_pacman")
        r.append(r"""if ! grep -q '^\[multilib\]' /etc/pacman.conf; then
  echo @MULTILIB@
  if grep -q cielos-ondata /etc/pacman.conf; then inc=/etc/pacman.d/cielos-ondata; else inc=/etc/pacman.d/mirrorlist; fi
  if grep -q '^#\[multilib\]' /etc/pacman.conf; then
    sudo sed -i "/^#\[multilib\]/{s/^#//;n;s|^#\?Include.*|Include = $inc|}" /etc/pacman.conf
  else
    printf '\n[multilib]\nInclude = %s\n' "$inc" | sudo tee -a /etc/pacman.conf >/dev/null
  fi
  sudo pacman -Sy
fi""".replace("@MULTILIB@", q("   " + tr("accendo multilib (i programmi a 32 bit, servono per i giochi)"))))
    if pk:
        r.append("aspetta_pacman")
        r.append("sudo pacman -S --needed --noconfirm " + " ".join(map(q, pk)))
    for sv in pl.get("servizi", []):
        r.append(f"sudo systemctl enable --now {q(sv)}")
    for sv in pl.get("servizi_utente", []):
        r.append(f"systemctl --user enable --now {q(sv)}")
    for g in pl.get("gruppi", []):
        r.append(f"getent group {q(g)} >/dev/null && sudo usermod -aG {q(g)} \"$USER\"")
    for porta in pl.get("ufw", []):
        r.append(f"command -v ufw >/dev/null && sudo ufw allow {q(porta)} || true")
    for c in pl.get("comandi", []):
        r.append(c)
    if pl.get("webapp"):
        w = pl["webapp"]
        r.append(f"{q(Path(__file__).resolve())} webapp {q(w.get('nome', pl['nome']))} {q(w['url'])} --id {q(pl['id'])}")
    if pl.get("tui"):
        t = pl["tui"]
        r.append(f"{q(Path(__file__).resolve())} _tui {q(pl['id'])} {q(tr(t['nome']))} {q(t['comando'])} {q(t.get('icona', 'utilities-terminal'))}")
    r.append(f"{q(Path(__file__).resolve())} _fatto {q(pl['id'])}")
    if pl.get("note"):
        r.append(f"echo; echo {q(tr('Nota: ') + pl['note'])}")
    return "\n".join(r)


def favicon(url, dest):
    """l'icona del sito (favicon.ico o apple-touch-icon), convertita in PNG; se non c'è, niente"""
    u = urllib.parse.urlparse(url)
    for p in ("/apple-touch-icon.png", "/favicon.ico"):
        try:
            req = urllib.request.Request(f"{u.scheme}://{u.netloc}{p}", headers={"User-Agent": "Mozilla/5.0 CielOS"})
            dati = urllib.request.urlopen(req, timeout=8).read()
            if len(dati) < 100:
                continue
            from io import BytesIO
            from PIL import Image
            im = Image.open(BytesIO(dati))
            if getattr(im, "n_frames", 1) > 1:              # .ico con più misure: la più grande
                im.size = max(im.info.get("sizes", [im.size]))
            im.convert("RGBA").resize((128, 128)).save(dest)
            return True
        except Exception:
            continue
    return False


def webapp(nome, url, wid=None):
    """una finestra sola per un sito: un profilo di LibreWolf senza barre, con la sua icona e il suo nome"""
    wid = wid or "web-" + re.sub(r"[^a-z0-9]+", "-", nome.lower()).strip("-")
    d = WEBAPP / wid
    (d / "profilo" / "chrome").mkdir(parents=True, exist_ok=True)
    (d / "profilo" / "user.js").write_text(
        'user_pref("toolkit.legacyUserProfileCustomizations.stylesheets", true);\n'
        'user_pref("browser.shell.checkDefaultBrowser", false);\n'
        'user_pref("browser.tabs.inTitlebar", 0);\n'
        'user_pref("browser.startup.homepage_override.mstone", "ignore");\n'
        'user_pref("privacy.resistFingerprinting", false);\n'          # i siti (WhatsApp, Spotify) altrimenti si rompono
        'user_pref("webgl.disabled", false);\n'
        'user_pref("privacy.clearOnShutdown.cookies", false);\n'       # resti dentro al sito tra una volta e l'altra
        'user_pref("privacy.sanitize.sanitizeOnShutdown", false);\n'
        'user_pref("browser.sessionstore.resume_from_crash", false);\n'
        # chiamate e condivisione dello schermo (Discord, Meet, Teams): WebRTC acceso, lo schermo dal portale di Wayland
        'user_pref("media.peerconnection.enabled", true);\n'
        'user_pref("media.navigator.enabled", true);\n'
        'user_pref("media.peerconnection.ice.no_host", false);\n'
        'user_pref("media.peerconnection.ice.proxy_only_if_behind_proxy", false);\n'
        'user_pref("media.webrtc.camera.allow-pipewire", true);\n')
    (d / "profilo" / "chrome" / "userChrome.css").write_text(
        "/* web app di CielOS: niente barre, solo il sito */\n"
        "#nav-bar, #TabsToolbar, #PersonalToolbar, #titlebar, #sidebar-box, #sidebar-main { visibility: collapse !important; }\n")
    icona = d / "icona.png"
    ha_icona = icona.exists() or favicon(url, icona)
    APPS.mkdir(parents=True, exist_ok=True)
    cmd = f"librewolf --no-remote --profile {qd(d / 'profilo')} --name {qd('webapp-' + wid)} --class {qd('webapp-' + wid)} {qd(url)}"
    (APPS / f"cielos-webapp-{wid}.desktop").write_text(
        f"[Desktop Entry]\nType=Application\nName={nome}\nComment=Web app: {url}\nExec={cmd}\n"
        f"Icon={icona if ha_icona else 'web-browser'}\nTerminal=false\nCategories=Network;WebApp;\n"
        f"StartupWMClass=webapp-{wid}\nKeywords=web;{nome.lower()};\n")
    s = stato()
    s.setdefault("webapp", {})[wid] = {"nome": nome, "url": url}
    salva(s)
    print("   " + tr("web app «%1»: la trovi nel lanciatore", nome))


def tui(pid, nome, comando, icona):
    APPS.mkdir(parents=True, exist_ok=True)
    term = os.environ.get("TERMINAL", "foot")
    (APPS / f"cielos-tui-{pid}.desktop").write_text(
        f"[Desktop Entry]\nType=Application\nName={nome}\nExec={term} --app-id=tui-{pid} -e sh -c {qd(comando)}\n"
        f"Icon={icona}\nTerminal=false\nCategories=System;ConsoleOnly;\n")


def cerca(pid):
    for pl in catalogo()["plugin"]:
        if pl["id"] == pid:
            return pl
    sys.exit(f"plugin sconosciuto: {pid} (cielplugin per l'elenco)")


def esegui(testo, qui):
    """lo script: qui (se sei in un terminale) o in un terminale nuovo, che resta aperto per leggere com'è andata"""
    f = Path(os.environ.get("XDG_RUNTIME_DIR", "/tmp")) / f"cielplugin-{os.getpid()}.sh"
    f.write_text("#!/bin/bash\n" + testo + "\n")
    f.chmod(0o700)
    if qui or sys.stdin.isatty():
        r = subprocess.run(["bash", str(f)]).returncode
        f.unlink(missing_ok=True)
        return r
    term = os.environ.get("TERMINAL") or shutil.which("foot") and "foot" or "xterm"
    # il riquadro e le Impostazioni sono pannelli sopra le finestre: si chiudono, se no il terminale resterebbe sotto;
    # alla fine si riapre quello di prima. Il terminale è flottante e centrato (regola cielplugin di cieltema).
    torna = ""
    for pannello, domanda, di_nuovo in (("riquadro", "aperto", "pagina install"), ("impostazioni", "aperta", "apri")):
        shell = ["qs", "-c", "ciel", "ipc", "call", pannello]
        try:
            if subprocess.run([*shell, domanda], capture_output=True, text=True, timeout=5).stdout.strip() == "true":
                subprocess.run([*shell, "chiudi"], capture_output=True, timeout=5)
                torna = f"; {' '.join(shell)} {di_nuovo} >/dev/null 2>&1"
                break
        except (OSError, subprocess.TimeoutExpired):
            pass
    subprocess.Popen([term, "--app-id=cielplugin", "-e", "bash", "-c",
                      f"bash {q(f)}; e=$?; rm -f {q(f)}; echo; [ $e = 0 ] && echo {q(tr('Fatto.'))} || echo {q(tr('Non è andata (errore'))} \"$e).\"; "
                      f"read -rsn1 -p {q(tr('Premi un tasto (anche Esc) per chiudere') + ' ')} x{torna}"] if term == "foot" else [term, "-e", "bash", str(f)])
    return 0


# ── Install (il riquadro, Super+A): come Shelly, tutte le fonti insieme ─────────────────────────────────────────────
SUFFISSI = re.compile(r"-(git|bin|appimage|nightly|beta|dev|canary|ptb|stable|latest|wayland|electron|nogpu|full|svn|hg)$")
NOME_PKG = re.compile(r"^[a-z0-9@_+][a-z0-9@._+-]{0,99}$")
NOME_FLATPAK = re.compile(r"^[A-Za-z0-9_-]+(\.[A-Za-z0-9_-]+){2,}$")
VERSIONE = re.compile(r"^[A-Za-z0-9.:+_~-]{1,64}$")
ALA = "https://archive.archlinux.org/packages"


def _json_url(url, dati=None, timeout=15):
    h = {"User-Agent": "CielOS"} | ({"Content-Type": "application/json"} if dati is not None else {})
    req = urllib.request.Request(url, data=json.dumps(dati).encode() if dati is not None else None, headers=h)
    with urllib.request.urlopen(req, timeout=timeout) as f:
        return json.load(f)


def _cerca_repo(testo):
    """i repository attivi (pacman -Ss): [(repo, nome, versione, descrizione)]"""
    out = subprocess.run(["pacman", "-Ss", "--", re.escape(testo)], capture_output=True, text=True,
                         env={**os.environ, "LANG": "C"}).stdout.splitlines()
    r = []
    for i, riga in enumerate(out):
        if riga and not riga[0].isspace():
            p = riga.split()
            if "/" in p[0] and len(p) > 1:
                repo, nome = p[0].split("/", 1)
                r.append((repo, nome, p[1], out[i + 1].strip() if i + 1 < len(out) else ""))
    return r


def _cerca_aur(testo):
    if len(testo) < 2:
        return []
    d = _json_url(f"https://aur.archlinux.org/rpc/v5/search/{urllib.parse.quote(testo)}?by=name-desc")
    return sorted(d.get("results", []), key=lambda x: -(x.get("Popularity") or 0))[:80]


def _cerca_flathub(testo):
    return _json_url("https://flathub.org/api/v2/search", {"query": testo}).get("hits", [])[:30]


def base(nome):
    """il programma, senza le varianti: «discord-canary-bin» → «discord»"""
    n, prima = nome.lower().strip(), None
    while n != prima:
        prima, n = n, SUFFISSI.sub("", n)
    return n


def cerca_tutto(testo):
    """Arch, AUR e Flathub insieme, raggruppati per programma: ogni gruppo con le sue varianti (fonti e versioni)"""
    from concurrent.futures import ThreadPoolExecutor
    t = testo.strip().lower()
    with ThreadPoolExecutor(3) as ex:
        fut = {k: ex.submit(f, testo.strip()) for k, f in (("repo", _cerca_repo), ("aur", _cerca_aur), ("flatpak", _cerca_flathub))}
    errori, ris = [], {}
    for k, fu in fut.items():
        try:
            ris[k] = fu.result()
        except Exception as e:
            ris[k] = []
            errori.append(tr("%1 non risponde (%2)", {"repo": "pacman", "aur": "AUR", "flatpak": "Flathub"}[k], str(e)[:80]))
    installati_pkg = set(subprocess.run(["pacman", "-Qq"], capture_output=True, text=True).stdout.split())
    gruppi = {}

    def metti(chiave, nome, descr, var):
        g = gruppi.setdefault(chiave, {"chiave": chiave, "nome": nome, "descrizione": "", "varianti": []})
        if not g["descrizione"] and descr:
            g["descrizione"] = descr
        g["varianti"].append(var)

    for repo, nome, ver, descr in ris["repo"]:
        metti(base(nome), nome, descr, {"fonte": "repo", "id": nome, "versione": ver, "tipo": repo,
                                         "installato": nome in installati_pkg, "peso": 3})
    for a in ris["aur"]:
        nome = a["Name"]
        tipo = "git" if nome.endswith(("-git", "-svn", "-hg")) else "bin" if nome.endswith(("-bin", "-appimage")) else "aur"
        metti(base(nome), nome, a.get("Description") or "",
              {"fonte": "aur", "id": nome, "versione": a.get("Version", ""), "tipo": tipo, "installato": nome in installati_pkg,
               "voti": a.get("NumVotes", 0), "vecchio": bool(a.get("OutOfDate")), "peso": 1 + min(1.5, (a.get("Popularity") or 0) / 5)})
    for h in ris["flatpak"]:
        metti(base(h.get("name", "").replace(" ", "-")), h.get("name", h["app_id"]), h.get("summary", ""),
              {"fonte": "flatpak", "id": h["app_id"], "versione": "", "tipo": "flatpak", "installato": installato_flatpak(h["app_id"]),
               "verificato": bool(h.get("verification_verified")), "scaricamenti_mese": h.get("installs_last_month", 0),
               "peso": 2 + min(1.0, (h.get("installs_last_month") or 0) / 20000)})

    ordine = {"repo": 0, "flatpak": 1, "aur": 2, "bin": 3, "git": 4}
    out = []
    for g in gruppi.values():
        k = g["chiave"]
        g["varianti"].sort(key=lambda v: (ordine.get(v["fonte"] if v["fonte"] != "aur" else v["tipo"], 5), v["id"]))
        fl = next((v for v in g["varianti"] if v["fonte"] == "flatpak"), None)
        g["nome"] = next((v["id"] for v in g["varianti"] if v["fonte"] == "repo"), None) or \
            (g["nome"] if fl else min((v["id"] for v in g["varianti"]), key=len))
        g["installato"] = any(v["installato"] for v in g["varianti"])
        g["punteggio"] = (100 if k == t else 40 if k.startswith(t) else 15 if t in k else 0) + \
            max(v["peso"] for v in g["varianti"]) + len(g["varianti"]) * 0.5
        out.append(g)
    out.sort(key=lambda g: -g["punteggio"])
    return {"testo": testo, "gruppi": out[:70], "errori": errori}


def versioni(fonte, nome):
    """le versioni che si possono scegliere: per i pacchetti di Arch quelle dell'Arch Linux Archive (anche le vecchie),
    per Flathub le uscite elencate nella sua scheda"""
    if fonte == "repo" and NOME_PKG.match(nome):
        req = urllib.request.Request(f"{ALA}/{nome[0]}/{nome}/", headers={"User-Agent": "CielOS"})
        with urllib.request.urlopen(req, timeout=20) as f:
            html = f.read().decode("utf-8", "replace")
        vs = []
        for h in re.findall(r'href="([^"]+\.pkg\.tar\.(?:zst|xz))"', html):
            file = urllib.parse.unquote(h)
            m = re.match(re.escape(nome) + r"-(.+)-(x86_64|any)\.pkg\.tar\.(zst|xz)$", file)
            if m:
                vs.append({"versione": m.group(1), "file": file, "url": f"{ALA}/{nome[0]}/{nome}/{h}"})
        vs.sort(key=lambda v: _chiave_versione(v["versione"]), reverse=True)
        return vs[:25]
    if fonte == "flatpak" and NOME_FLATPAK.match(nome):
        d = _json_url(f"https://flathub.org/api/v2/appstream/{nome}")
        return [{"versione": r.get("version", ""), "data": time.strftime("%Y-%m-%d", time.gmtime(int(r["timestamp"])))
                 if str(r.get("timestamp", "")).isdigit() else ""} for r in (d.get("releases") or [])[:10]]
    return []


def _chiave_versione(v):
    try:
        from functools import cmp_to_key
        return cmp_to_key(lambda a, b: int(subprocess.run(["vercmp", a, b], capture_output=True, text=True).stdout or 0))(v)
    except Exception:
        return v


def script_pacchetto(fonte, nome, versione=None):
    """lo script per installare UNA variante: dai repository (anche una versione vecchia dall'archivio), AUR o Flathub"""
    r = ["set -e", aspetta()]
    if fonte == "repo":
        if not NOME_PKG.match(nome):
            raise SystemExit(tr("«%1» non è un nome di pacchetto valido.", nome))
        if versione:
            v = next((x for x in versioni("repo", nome) if x["versione"] == versione), None)
            if not v:
                raise SystemExit(tr("Versione %1 di %2 non trovata nell'archivio di Arch.", versione, nome))
            r += [f"echo {q('── ' + nome + ' ' + versione + ' ' + tr('(dall’archivio di Arch)'))}", "aspetta_pacman",
                  f"sudo pacman -U --noconfirm {q(v['url'])}",
                  "echo " + q("   " + tr("Il prossimo aggiornamento la porta all'ultima versione."))]
        else:
            r += [f"echo {q('── ' + nome + ': ' + tr('installo'))}", "aspetta_pacman", f"sudo pacman -S --needed --noconfirm {q(nome)}"]
    elif fonte == "aur":
        if not NOME_PKG.match(nome):
            raise SystemExit(tr("«%1» non è un nome di pacchetto valido.", nome))
        r += [f"echo {q('── ' + nome + ' (AUR): ' + tr('installo'))}",
              "echo " + q("   " + tr("Dall'AUR: una ricetta della comunità, Arch non la controlla. Si compila sul tuo PC.")),
              "aspetta_pacman", PARU, "aspetta_pacman", f"paru -S --needed --noconfirm --skipreview {q(nome)}"]
    elif fonte == "flatpak":
        if not NOME_FLATPAK.match(nome):
            raise SystemExit(tr("«%1» non è un nome di Flatpak valido.", nome))
        r += [f"echo {q('── ' + nome + ' (Flathub): ' + tr('installo'))}",
              "echo " + q("   " + tr("Da Flathub: il programma gira isolato dal sistema (Flatpak).")),
              "aspetta_pacman", "command -v flatpak >/dev/null || sudo pacman -S --needed --noconfirm flatpak",
              "flatpak remote-add --user --if-not-exists flathub https://dl.flathub.org/repo/flathub.flatpakrepo",
              f"flatpak install --user -y --noninteractive flathub {q(nome)}",
              "echo " + q("   " + tr("(se non lo vedi subito nel menu delle app, esci e rientra una volta)"))]
    else:
        raise SystemExit(tr("fonte sconosciuta: %1", fonte))
    return "\n".join(r)


def protetto(nome):
    """i pacchetti che il guardiano non toglie mai (senza, il PC non parte o non si ripara)"""
    global _PROTETTI
    if _PROTETTI is None:
        try:
            sys.path.insert(0, str(RADICE / "guardiano"))
            from azioni import PACCHETTI_PROTETTI
            _PROTETTI = PACCHETTI_PROTETTI
        except ImportError:
            _PROTETTI = re.compile(r"^(base|linux.*|systemd.*|glibc|pacman.*|sudo|cielos.*|.*-keyring)$")
    return bool(_PROTETTI.match(nome))


_PROTETTI = None


def installati_con(testo):
    """tutto quello che è installato e contiene quelle lettere: pacchetti (repository o AUR) e Flatpak"""
    t = testo.strip().lower()
    if not t:
        return {"testo": testo, "voci": []}
    tutti = dict(r.split(" ", 1) for r in subprocess.run(["pacman", "-Q"], capture_output=True, text=True).stdout.splitlines() if " " in r)
    esterni = set(subprocess.run(["pacman", "-Qmq"], capture_output=True, text=True).stdout.split())
    espliciti = set(subprocess.run(["pacman", "-Qeq"], capture_output=True, text=True).stdout.split())
    voci = [{"fonte": "aur" if n in esterni else "repo", "id": n, "nome": n, "versione": v, "esplicito": n in espliciti,
             "protetto": protetto(n)} for n, v in sorted(tutti.items()) if t in n.lower()]
    try:
        fl = subprocess.run(["flatpak", "list", "--app", "--columns=application,name,version"], capture_output=True,
                            text=True, timeout=20).stdout.splitlines()
    except (OSError, subprocess.TimeoutExpired):
        fl = []
    for r in fl:
        p = (r.split("\t") + ["", ""])[:3]
        if t in p[0].lower() or t in p[1].lower():
            voci.append({"fonte": "flatpak", "id": p[0], "nome": p[1] or p[0], "versione": p[2], "esplicito": True, "protetto": False})
    return {"testo": testo, "voci": voci}


def script_rimuovi(voci):
    """toglie tutto insieme; se pacman rifiuta (qualcosa serve ad altri programmi) li prova uno per uno e tiene quelli che servono"""
    pk = [v.split(":", 1)[1] for v in voci if v.startswith(("repo:", "aur:"))]
    fl = [v.split(":", 1)[1] for v in voci if v.startswith("flatpak:")]
    no = [p for p in pk if protetto(p) or not NOME_PKG.match(p)]
    pk = [p for p in pk if p not in no]
    fl = [x for x in fl if NOME_FLATPAK.match(x)]
    r = [aspetta()]
    if no:
        r.append("echo " + q(tr("Questi non li tolgo (senza, il PC potrebbe non partire): %1", " ".join(no))))
    if pk:
        lista = " ".join(map(q, pk))
        r += [f"echo {q('── ' + tr('Tolgo %1 pacchetti', len(pk)))}", "aspetta_pacman",
              f"sudo pacman -Rns --noconfirm {lista} || {{ echo {q(tr('Insieme non si può: li provo uno per uno.'))}; "
              f"for p in {lista}; do pacman -Q \"$p\" >/dev/null 2>&1 || continue; "
              f"sudo pacman -Rns --noconfirm \"$p\" >/dev/null 2>&1 && echo \"   ✓ $p\" || echo \"   · $p: \"{q(tr('serve ad altro: resta'))}; done; }}"]
    for x in fl:
        r.append(f"echo {q('── ' + x + ' (Flatpak)')}; flatpak uninstall -y --noninteractive {q(x)} || "
                 f"flatpak uninstall --user -y --noninteractive {q(x)} || true")
    return "\n".join(r)


def script_aggiorna_tutto():
    """il sistema con le ondate (il guardiano, con l'istantanea), poi l'AUR, poi i Flatpak"""
    return "\n".join([
        aspetta(),
        "echo " + q("── " + tr("Sistema (pacchetti di Arch e di CielOS: con l'istantanea prima)")),
        f"{q(RADICE / 'bin/cielos')} aggiorna || true",
        "if command -v paru >/dev/null && [ -n \"$(pacman -Qmq)\" ]; then echo; echo " + q("── " + tr("Pacchetti dell'AUR")) + "; "
        "aspetta_pacman; paru -Sua --noconfirm --skipreview || true; fi",
        "if command -v flatpak >/dev/null; then echo; echo " + q("── Flatpak") + "; "
        "flatpak update --user -y --noninteractive || true; flatpak update -y --noninteractive 2>/dev/null || true; fi"])


def main():
    a = sys.argv[1:]
    if a[:1] in (["-h"], ["--help"]):
        print(tr(__doc__.strip())); return
    c = catalogo()
    s = stato()
    if not a or a[0] == "elenco":
        out = []
        for pl in c["plugin"]:
            out.append({**pl, "installato": e_installato(pl, s), "pacchetti": pacchetti_di(pl) + pl.get("aur", []),
                        "fonte": fonte(pl)})
        if "--json" in a:
            print(json.dumps({"categorie": c["categorie"], "plugin": out, "webapp": s.get("webapp", {})}, ensure_ascii=False)); return
        for cat, (_, nome) in c["categorie"].items():
            print(f"\n{nome}")
            for pl in out:
                if pl["categoria"] == cat:
                    print(f"  {'✓' if pl['installato'] else ' '} {pl['id']:<20} {pl['descrizione']}")
        return
    cmd, resto = a[0], [x for x in a[1:] if not x.startswith("--")]
    qui = "--qui" in a
    if cmd in ("installa", "togli") and resto:
        testo = "\n".join(script(cerca(pid), togli=cmd == "togli") for pid in resto)
        if cmd == "togli":
            testo += "\n" + "\n".join(f"{q(Path(__file__).resolve())} _tolto {q(pid)}" for pid in resto)
        sys.exit(esegui(testo, qui))
    elif cmd == "cerca":
        testo = " ".join(resto)
        r = cerca_tutto(testo) if testo.strip() else {"testo": "", "gruppi": [], "errori": []}
        if "--json" in a:
            print(json.dumps(r, ensure_ascii=False)); return
        for g in r["gruppi"]:
            print(f"{'✓' if g['installato'] else ' '} {g['nome']:<28} {g['descrizione'][:70]}")
            for v in g["varianti"]:
                print(f"     {v['fonte']:<8} {v['id']:<36} {v['versione']}")
    elif cmd == "versioni" and len(resto) == 2:
        try:
            r = versioni(*resto)
        except Exception as e:
            r = []
            if "--json" not in a:
                print(tr("Non riesco a leggere le versioni: %1", e))
        if "--json" in a:
            print(json.dumps({"versioni": r}, ensure_ascii=False)); return
        for v in r:
            print(v["versione"], v.get("data", ""))
    elif cmd == "pacchetto" and len(resto) in (2, 3):
        sys.exit(esegui(script_pacchetto(*resto), qui))
    elif cmd == "installati":
        r = installati_con(" ".join(resto))
        if "--json" in a:
            print(json.dumps(r, ensure_ascii=False)); return
        for v in r["voci"]:
            print(f"{'🔒' if v['protetto'] else ' '} {v['fonte']:<8} {v['id']:<36} {v['versione']}")
    elif cmd == "rimuovi" and resto:
        sys.exit(esegui(script_rimuovi(resto), qui))
    elif cmd == "aggiorna-tutto":
        sys.exit(esegui(script_aggiorna_tutto(), qui))
    elif cmd == "script" and resto:
        print(script(cerca(resto[0]), togli="--togli" in a))
    elif cmd == "webapp" and len(resto) >= 2:
        wid = a[a.index("--id") + 1] if "--id" in a else None
        webapp(resto[0], resto[1], wid)
    elif cmd == "_tui" and len(resto) == 4:
        tui(*resto)
    elif cmd == "_fatto" and resto:
        s["installati"][resto[0]] = time.strftime("%Y-%m-%d %H:%M"); salva(s)
        subprocess.run([str(RADICE / "bin/cielos-hook"), "plugin", resto[0]])
    elif cmd == "_tolto" and resto:
        s["installati"].pop(resto[0], None); s.get("webapp", {}).pop(resto[0], None); salva(s)
    else:
        sys.exit(tr(__doc__.strip()))


if __name__ == "__main__":
    main()
