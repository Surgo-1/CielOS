#!/bin/sh
# Il file manager di CielOS: ciel-file [CARTELLA]
R=${CIELOS_DIR:-$(dirname "$(readlink -f "$0")")/..}
D="${1:-$HOME}"
case "$D" in file://*) D=$(printf '%s' "${D#file://}" | sed 's/%20/ /g') ;; esac
[ -f "$D" ] && D=$(dirname "$D")
CIEL_FILE_DOVE="$(readlink -f "$D")" exec qs -n -p "$R/app/file"
