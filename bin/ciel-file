#!/bin/sh
# Il file manager di CielOS.
#   ciel-file              apre la tua cartella personale
#   ciel-file CARTELLA     apre quella cartella (o la cartella che contiene un file)
case "${1:-}" in aiuto|--aiuto|-h|help) awk 'NR>1 && /^#/ { sub(/^# ?/, ""); print; next } NR>1 { exit }' "$0"; exit 0 ;; esac
R=${CIELOS_DIR:-$(dirname "$(readlink -f "$0")")/..}
D="${1:-$HOME}"
case "$D" in file://*) D=$(printf '%s' "${D#file://}" | sed 's/%20/ /g') ;; esac
[ -f "$D" ] && D=$(dirname "$D")
CIEL_FILE_DOVE="$(readlink -f "$D")" exec qs -n -p "$R/app/file"
