        return [
            Voce(tr("Luce notturna") + ("  ←" if luce else ""), lambda: self._strumento("luce"),
                 tr("Schermo più caldo la sera")),
            Voce(tr("Resta sveglio") + ("  ←" if sveglio else ""), lambda: self._strumento("sveglio"),
                 tr("Niente blocco né sospensione")),
            Voce((tr("Ferma la registrazione") if registra else tr("Registra lo schermo")) + ("  ←" if registra else ""),
                 self._registra, tr("Video in Video/Registrazioni")),
            Voce(tr("DNS"), lambda: self.menu(tr("DNS"), self._voci_dns), tr("Il DNS di tutto il PC")),
            Voce(tr("Appunti"), self._appunti, tr("La cronologia (cliphist)")),
            Voce(tr("Emoji"), self._emoji, tr("Copia un'emoji negli appunti")),
            Voce(tr("Testo da un'area (OCR)"), lambda: self.esegui([BIN / "cielstrumenti", "testo"]),
                 tr("Scegli un'area: il testo finisce negli appunti")),
            Voce(tr("Codice QR da un'area"), lambda: self.esegui([BIN / "cielstrumenti", "qr"]),
                 tr("Il contenuto del QR negli appunti")),
            Voce(tr("Colore da un'area"), lambda: self.esegui([BIN / "cielstrumenti", "colore"]),
                 tr("Il colore finisce negli appunti")),
            Voce(tr("QR del Wi-Fi"), self._wifi_qr, tr("Per collegare un telefono")),
            Voce(tr("Velocità della rete"), self._velocita_rete, tr("Cloudflare: misura l'internet")),
            Voce(tr("Velocità del disco"), self._velocita_disco, tr("Scrive e legge 512 MB, poi li toglie")),
            Voce(tr("Scorciatoie"), self._scorciatoie, tr("Tutte le scorciatoie di Hyprland")),
        ]

    def _strumento(self, nome):
        self._fai([BIN / "cielstrumenti", nome], timeout=30)

    def _registra(self):
        if self.conferma(tr("Registro lo schermo? Scegli l'area con il mouse; di nuovo qui per fermare.")):
            self.esegui([BIN / "cielstrumenti", "registra"])

    def _voci_dns(self):
        m = [("automatico", tr("Automatico (DHCP)")), ("cloudflare", "Cloudflare"),
             ("google", "Google"), ("quad9", "Quad9")]
        return [Voce(t, lambda v=v: self._fai([BIN / "cielstrumenti", "dns", v], timeout=120), v)
                for v, t in m]

    def _appunti(self):
        d = _cmd_json([BIN / "cielstrumenti", "appunti", "--json"], timeout=30) or {}
        voci = []
        for x in d.get("voci", []) or d.get("appunti", []):
            if isinstance(x, dict):
                voci.append(Voce(str(x.get("testo", ""))[:110],
                                 lambda i=x.get("id"): self._fai([BIN / "cielstrumenti", "appunti", "copia", str(i)])))
        if not voci:
            self.avviso = tr("Gli appunti sono vuoti.")
            return
        voci.append(Voce(tr("Svuota la cronologia"),
                         lambda: self.conferma(tr("Svuoto la cronologia degli appunti?")) and
                         self._fai([BIN / "cielstrumenti", "appunti", "svuota"])))
        self.menu(tr("Appunti"), voci, filtrabile=True)

    def _emoji(self):
        d = _cmd_json([BIN / "cielstrumenti", "emoji", "--json"], timeout=30) or {}
        voci = []
        for x in d.get("emoji", d.get("voci", [])):
            if isinstance(x, dict):
                testo = x.get("emoji") or x.get("testo") or ""
                nome = x.get("nome", "")
                voci.append(Voce(f"{testo}  {nome}", lambda t=testo: self._fai([BIN / "cielstrumenti", "emoji", "copia", t]),
                                 tr("copia negli appunti")))
        if not voci:
            self.avviso = tr("Nessuna emoji.")
            return
        self.menu(tr("Emoji"), voci, filtrabile=True)

    def _wifi_qr(self):
        r = subprocess.run([str(BIN / "cielstrumenti"), "wifi-qr"], capture_output=True, text=True, timeout=60)
        self.mostra(r.stdout or r.stderr, tr("QR del Wi-Fi"))

    def _velocita_rete(self):
