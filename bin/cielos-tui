    # ── guida ──
    def _guida(self):
        pagine = sorted((RADICE / "wiki").glob("*.md"))
        voci = []
        for p in pagine:
            titolo = p.stem.split("-", 1)[-1].replace("-", " ")
            voci.append(Voce(titolo.capitalize(), lambda p=p: self.mostra(p.read_text(), p.stem),
                             tr("anche senza internet")))
        if not voci:
            self.avviso = tr("La guida non c'è.")
            return
        self.menu(tr("Guida"), voci, filtrabile=True)

    # ── sistema (dal vivo) ──
    def _sistema(self):
        self.s.timeout(1000)
        try:
            while True:
                righe = self._righe_sistema()
                self.s.erase()
                h, w = self._dim()
                self.s.attron(curses.A_REVERSE)
                self.s.addnstr(0, 0, " CielOS · Sistema ".ljust(w), w)
                self.s.attroff(curses.A_REVERSE)
                for i, r in enumerate(righe[:h - 3]):
                    self.s.addnstr(2 + i, 2, r, w - 4)
                self.s.addnstr(h - 1, 2, tr("Aggiornato ogni secondo · un tasto per tornare"), w - 4, curses.A_DIM)
                self.s.refresh()
                k = self._tasto()
                if k is not None and k != curses.KEY_RESIZE:
                    return
        finally:
            self.s.timeout(-1)
            self.s.clear()
            self.s.refresh()

    def _righe_sistema(self):
        righe = [_stato_breve(), ""]
        try:
            carichi = os.getloadavg()
            righe.append(tr("Carico: %1 %2 %3", f"{carichi[0]:.2f}", f"{carichi[1]:.2f}", f"{carichi[2]:.2f}"))
        except OSError:
            pass
        try:
            ncpu = os.cpu_count() or 1
            righe.append(tr("Processori: %1", ncpu))
        except Exception:
            pass
        try:
            su = float(Path("/proc/uptime").read_text().split()[0])
            righe.append(tr("Acceso da: %1h %2m", int(su // 3600), int(su % 3600 // 60)))
        except (OSError, ValueError):
            pass
        righe.append(tr("Memoria: %1", _ram()))
        try:
            for nome in ("root", "home"):
                u = shutil.disk_usage("/" if nome == "root" else str(Path.home()))
                righe.append(tr("Disco %1: %2 GB liberi di %3 GB", nome, f"{u.free / 1073741824:.0f}",
                                f"{u.total / 1073741824:.0f}"))
        except OSError:
            pass
        r = _cmd_json([BIN / "cielrete", "stato", "--json"], timeout=20) or {}
        w = r.get("wifi", {})
        e = r.get("cavo", {})
        if w.get("presente"):
            if not w.get("acceso"):
                stato_wifi = tr("spento")
            elif w.get("collegato"):
                stato_wifi = tr("acceso") + " · " + str(w.get("rete", ""))
            else:
                stato_wifi = tr("acceso") + " · " + tr("non collegato")
            righe.append(tr("Wi-Fi: %1", stato_wifi))
        if e.get("presente"):
            righe.append(tr("Cavo: %1", e.get("rete") if e.get("collegato") else tr("non collegato")))
        righe.append(tr("Batteria: %1", _batteria() or tr("nessuna")))
        return righe

    # ── sessione ──
    def _voci_sessione(self):
        return [
            Voce(tr("Blocca"), lambda: self._fai(["loginctl", "lock-session"], timeout=10),
                 tr("La schermata della password")),
            Voce(tr("Sospendi"), lambda: self.conferma(tr("Sospendo il PC?")) and self._fai(["systemctl", "suspend"]),
                 tr("Consuma quasi niente")),
            Voce(tr("Esci dalla sessione"), lambda: self.conferma(tr("Chiudo la sessione? Le app si chiudono."))
                 and self._fai(["hyprctl", "dispatch", "exit"], timeout=10), tr("Torna al login")),
            Voce(tr("Riavvia"), lambda: self.conferma(tr("Riavvio il PC?"))
                 and self._fai(["systemctl", "reboot"], timeout=10), tr("Chiude tutto")),
            Voce(tr("Spegni"), lambda: self.conferma(tr("Spengo il PC?"))
                 and self._fai(["systemctl", "poweroff"], timeout=10), tr("Chiude tutto")),
        ]

    # ── comando ──
    def _comando(self):
        riga = self.chiedi(tr("Comando (sh):"))
        if riga:
            self.esegui(riga)


    # ── rete ──
    def _voci_rete(self):
        r = _cmd_json([BIN / "cielrete", "stato", "--json"], timeout=30) or {}
        w = r.get("wifi", {})
        voci = [Voce(tr("Wi-Fi") + (": " + (tr("acceso") + (" · " + w["rete"] if w.get("collegato") else "")
                                                   if w.get("acceso") else tr("spento")) if w.get("presente") else ": " + tr("non c'è")),
                     lambda: self._fai([BIN / "cielrete", "wifi"], timeout=30),
                     tr("Accende o spegne (senza: cambia)"))]
        if w.get("presente"):
            voci.append(Voce(tr("Scegli una rete Wi-Fi…"), self._reti, tr("Le reti vicine, con il segnale")))
        for c in r.get("connessioni", []):
            voci.append(Voce(f"{c.get('tipo')}: {c.get('nome')} · {c.get('indirizzo', '')}",
                             lambda c=c: self.conferma(tr("Esco da %1?", c.get("nome"))) and
                             self._fai([BIN / "cielrete", "scollega", c["nome"]], timeout=30),
                             tr("collegato")))
        voci.append(Voce(tr("DNS: %1", r.get("dns", "automatico")),
                         lambda: self.menu(tr("DNS"), self._voci_dns), tr("Per tutto il PC")))
        voci.append(Voce(tr("Indirizzi di adesso"),
                         lambda: self.mostra(json.dumps(r, indent=2, ensure_ascii=False), tr("Rete"))))
        return voci

    def _reti(self):
        r = _cmd_json([BIN / "cielrete", "reti", "--rescan", "--json"], timeout=60) or {}
        voci = []
        for x in r.get("reti", []):
            nome = x.get("nome") or x.get("ssid") or ""
            segnale = x.get("segnale", x.get("signal", ""))
            etichetta = nome + (" · " + str(segnale) if segnale != "" else "") + (" 🔒" if x.get("sicura", x.get("security")) else "")
            voci.append(Voce(etichetta, lambda nome=nome, x=x: self._connetti(nome, x),
                             tr("in uso") if x.get("in_uso", x.get("attiva")) else ""))
        if not voci:
            self.avviso = tr("Nessuna rete trovata.")
            return
        self.menu(tr("Reti Wi-Fi"), voci, filtrabile=True)

    def _connetti(self, nome, x):
        if not nome:
            return
        pw = self.chiedi(tr("Password di «%1» (vuota se aperta):", nome), password=True)
        if pw is None:
            return
        self._fai([BIN / "cielrete", "connetti", nome, "--password-stdin"], timeout=90, testo=pw + "\n")

    # ── energia ──
    def _voci_energia(self):
        r = _cmd_json([BIN / "cielimposta", "stato"], timeout=30) or {}
        e = r.get("energia", {}) or {}
        attuale = e.get("profilo", "")
        voci = [Voce(tr("Profilo: %1", p) + ("  ←" if p == attuale else ""),
                     lambda p=p: self._fai([BIN / "cielimposta", "energia", p], timeout=30),
                     {"power-saver": tr("Consuma il meno possibile"),
                      "balanced": tr("Il compromesso di serie"),
                      "performance": tr("Tutta la potenza, consuma di più")}.get(p, ""))
                for p in (e.get("profili") or ["balanced"])]
        for b in e.get("batterie", []):
            voci.append(Voce(tr("Batteria %1: %2% · %3", b.get("nome", ""), b.get("carica", 0), b.get("stato", "")), None))
        voci.append(Voce(tr("Batteria e sospensione"),
                         lambda: self.esegui([BIN / "cielos-energia", "stato"]) if (BIN / "cielos-energia").exists() else None,
                         tr("Cosa dice il servizio dell'energia")))
        return voci

    # ── schermi ──
    def _voci_schermi(self):
        r = _cmd_json([BIN / "cielimposta", "stato"], timeout=30) or {}
        voci = [Voce(tr("%1 · %2×%3 · %4 Hz%5", s.get("nome"), s.get("l"), s.get("a"), s.get("hz"),
                          (" · " + tr("spento")) if s.get("spento") else ""),
                     lambda s=s: self.menu(s.get("nome", ""), lambda: self._voci_schermo(s)),
                     s.get("descrizione", "")) for s in r.get("schermi", [])]
        voci.append(Voce(tr("Annulla le ultime modifiche"),
                         lambda: self._fai([BIN / "cielimposta", "schermo-annulla"], timeout=30),
                         tr("Rimette gli schermi di prima")))
        return voci

    def _voci_schermo(self, s):
        nome = s.get("nome", "")
        voci = []
        for m in s.get("modi", []):
            voci.append(Voce(tr("Modo: %1", m.get("testo", m.get("valore", ""))),
                             lambda v=m.get("valore", ""): self._schermo(nome, f"mode={v}"),
                             tr("risoluzione e frequenza")))
        for sc in ("0.75", "1", "1.25", "1.5", "1.75", "2"):
            voci.append(Voce(tr("Scala: %1", sc), lambda sc=sc: self._schermo(nome, f"scale={sc}"),
                             tr("più grande o più piccolo")))
        for g, testo in enumerate((tr("normale"), tr("90°"), tr("180°"), tr("270°"))):
            voci.append(Voce(tr("Rotazione: %1", testo), lambda g=g: self._schermo(nome, f"transform={g}")))
        voci.append(Voce(tr("Spegni questo schermo") if not s.get("spento") else tr("Riaccendilo"),
                         lambda: self._schermo(nome, "disabled=%d" % (0 if s.get("spento") else 1))))
        return voci

    def _schermo(self, nome, modifica):
        self._fai([BIN / "cielimposta", "schermo", nome, modifica], timeout=40)


# ── avvio ───────────────────────────────────────────────────────────────────────────────────────────────────────
def main():
    sezione = ""
    for a in sys.argv[1:]:
        if a in ("-h", "--help", "--aiuto", "aiuto", "help"):
            print(__doc__)
            return 0
        if not a.startswith("-"):
            sezione = a
    if not sys.stdin.isatty():
        print(tr("cielos-tui si usa in un terminale: apri un terminale e scrivi «cielos-tui»."))
        return 1
    os.environ.setdefault("ESCDELAY", "25")
    os.environ["CIELOS_TUI"] = "1"          # già nel terminale: nessun altro terminale al cambio di modalità
    try:
        return curses.wrapper(lambda s: TUI(s).avvia(sezione))
    except KeyboardInterrupt:
        return 0


if __name__ == "__main__":
    sys.exit(main())
