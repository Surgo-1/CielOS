                righe.append(f"{x.get('tasto', x.get('scorciatoia', '')):<24} {x.get('descrizione', x.get('azione', ''))}")
        self.mostra("\n".join(righe) or json.dumps(d, indent=2, ensure_ascii=False), tr("Scorciatoie"))

    # ── medico ──
    def _medico(self):
        d = _cmd_json([BIN / "cielmedico", "--json"], timeout=180) or {}
        voci = []
        for x in d.get("voci", []):
            g = x.get("gravita", "")
            segno = {"ok": "✓", "consiglio": "•", "attenzione": "!", "problema": "✗"}.get(g, "·")
            if x.get("ripara"):
                voci.append(Voce(f"{segno} {x.get('titolo', '')}", lambda x=x: self._ripara(x),
                                 x.get("dettaglio", "") + " " + x.get("rimedio", "")))
            else:
                voci.append(Voce(f"{segno} {x.get('titolo', '')}", None,
                                 x.get("dettaglio", "") + " " + x.get("rimedio", "")))
        if any(x.get("ripara") for x in d.get("voci", [])):
            voci.insert(0, Voce(tr("Ripara tutto quello che si può"), self._ripara_tutto, tr("Con la tua conferma")))
        voci.append(Voce(tr("Visita completa (testo)"),
                         lambda: self.esegui([BIN / "cielmedico"]), tr("Ogni controllo, per esteso")))
        self.menu(d.get("riassunto", tr("Medico")), voci)

    def _ripara(self, x):
        if not self.conferma(tr("Riparo: %1?", x.get("titolo", x.get("id", "")))):
            return
        self.esegui([BIN / "cielmedico", "ripara", x.get("id", "")])

    def _ripara_tutto(self):
        if self.conferma(tr("Applico tutte le riparazioni? Quelle da amministratore chiedono la password.")):
            self.esegui([BIN / "cielmedico", "ripara", "tutto"])

