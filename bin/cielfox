#!/bin/sh
# CielFox: il browser di CielOS (LibreWolf con il profilo di CielFox, Ciel nella barra laterale, l'icona sua).
# A ogni avvio rimette le impostazioni del profilo e l'estensione aggiornata; il ponte con Ciel è registrato qui.
#   cielfox                    apre il browser (con le scelte di cielos.json)
#   cielfox INDIRIZZO          apre il browser su quella pagina
#   cielfox --privato [IND]    una finestra privata (non resta niente: cronologia, cookie, cache)
#   cielfox --verifica         controlla il profilo, l'estensione, il ponte con Ciel e il tema (non apre niente)
#   cielfox --aiuto            questa guida (senza aprire niente)
case "${1:-}" in aiuto|--aiuto|-h|help) awk 'NR>1 && /^#/ { sub(/^# ?/, ""); print; next } NR>1 { exit }' "$0"; exit 0 ;; esac
C="${CIELOS_DIR:-$(dirname "$(readlink -f "$0")")/..}/cielfox"
P="${CIELFOX_PROFILO:-$HOME/.local/share/cielfox/profilo}"
mkdir -p "$P/extensions" "$P/chrome"
cp "$C/profilo/user.js" "$P/user.js"
for f in userChrome.css userContent.css; do [ -f "$C/profilo/$f" ] && cp "$C/profilo/$f" "$P/chrome/$f"; done
# gli angoli e i colori di CielOS (li scrive cieltema: cambiano con il preset grafico), nel file che userChrome.css importa
CIEL_CSS="${XDG_CONFIG_HOME:-$HOME/.config}/cielos/cielfox.css"
if [ -f "$CIEL_CSS" ]; then cp "$CIEL_CSS" "$P/chrome/ciel.css"; else rm -f "$P/chrome/ciel.css"; fi
python3 "$C/profilo/barra.py" "$P" 2>/dev/null     # il bottone di Ciel in vista, una volta sola
# l'estensione impacchettata (solo se è cambiata)
X="$P/extensions/ciel@cielos.xpi"
if [ ! -f "$X" ] || [ -n "$(find "$C/estensione" -newer "$X" -type f | head -1)" ]; then
    rm -f "$X"; (cd "$C/estensione" && zip -qr -X "$X" . -x '*.swp')
fi
# il ponte: registrato per LibreWolf (e per Firefox, se un giorno firmiamo l'estensione)
for d in "$HOME/.librewolf/native-messaging-hosts" "$HOME/.config/librewolf/native-messaging-hosts" \
         "$HOME/.mozilla/native-messaging-hosts" "$HOME/.config/mozilla/native-messaging-hosts"; do
    mkdir -p "$d"
    printf '{"name":"cielfox","description":"Il ponte di CielFox con Ciel","path":"%s","type":"stdio","allowed_extensions":["ciel@cielos"]}\n' \
        "$C/ponte/cielfox_ponte.py" > "$d/cielfox.json"
done
# solo LibreWolf: il Firefox normale non accetta l'estensione di Ciel (non è firmata da Mozilla) e si porta dietro
# telemetria e notizie. Niente ripieghi silenziosi (14/10: era partito Firefox).
# ── la verifica: profilo, estensione, ponte e tema in una lista, senza aprire il browser ─────────────────────────
verifica() {
    guai=0; avvisi=0
    bene()  { printf '  ✓ %s\n' "$1"; }
    guaio() { printf '  ✗ %s\n' "$1"; guai=$((guai + 1)); }
    avviso(){ printf '  · %s\n' "$1"; avvisi=$((avvisi + 1)); }
    echo "CielFox — verifica"
    [ -n "$(command -v librewolf)" ] && bene "LibreWolf c'è ($(librewolf --version 2>/dev/null | head -1))" \
        || guaio "manca LibreWolf: sudo pacman -S librewolf"
    [ -s "$P/user.js" ] && bene "impostazioni del profilo (user.js)" || guaio "user.js non c'è nel profilo"
    for f in userChrome.css userContent.css; do
        [ -s "$P/chrome/$f" ] && bene "aspetto: chrome/$f" || guaio "manca chrome/$f (l'aspetto di CielFox)"
    done
    if [ -s "$P/chrome/ciel.css" ]; then bene "colori e angoli di CielOS (ciel.css)"
    else avviso "il tema di CielOS non è ancora generato: Impostazioni → Aspetto (o cieltema genera)"; fi
    if [ -s "$X" ] && unzip -p "$X" manifest.json >/dev/null 2>&1; then
        bene "estensione «Ciel per CielFox» v$(unzip -p "$X" manifest.json | python3 -c 'import json,sys;print(json.load(sys.stdin)["version"])' 2>/dev/null)"
    else guaio "l'estensione non è impacchettata bene ($X)"; fi
    for d in "$HOME/.librewolf/native-messaging-hosts" "$HOME/.config/librewolf/native-messaging-hosts"; do
        [ -s "$d/cielfox.json" ] && bene "ponte registrato ($d/cielfox.json)" && break
    done || true
    [ -s "$HOME/.librewolf/native-messaging-hosts/cielfox.json" ] || [ -s "$HOME/.config/librewolf/native-messaging-hosts/cielfox.json" ] \
        || guaio "il ponte non è registrato per LibreWolf"
    if [ -x "$C/ponte/cielfox_ponte.py" ] || [ -f "$C/ponte/cielfox_ponte.py" ]; then
        risposta=$(python3 - "$C/ponte/cielfox_ponte.py" <<'PY' 2>/dev/null
import json, struct, subprocess, sys
p = subprocess.Popen([sys.executable, sys.argv[1]], stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
try:
    d = json.dumps({"tipo": "ciao"}).encode()
    p.stdin.write(struct.pack("<I", len(d)) + d); p.stdin.flush()
    n = p.stdout.read(4)
    r = json.loads(p.stdout.read(struct.unpack("<I", n)[0])) if len(n) == 4 else {}
    print(r.get("tipo", ""))
except Exception:
    pass
finally:
    p.kill()
PY
)
        [ "$risposta" = ciao ] && bene "il ponte risponde (Ciel e i modelli raggiungibili)" \
            || guaio "il ponte non risponde (registro: ~/.local/state/cielos/cielfox/ponte.log)"
    else guaio "manca ponte/cielfox_ponte.py"; fi
    echo
    if [ $guai = 0 ]; then
        [ $avvisi -gt 0 ] && echo "Tutto a posto (avvisi: $avvisi)." || echo "Tutto a posto."
        return 0
    fi
    echo "Da sistemare: $guai. Avvisi: $avvisi."
    return 1
}

B=$(command -v librewolf)
if [ -z "$B" ] && [ "${1:-}" != "--verifica" ]; then
    notify-send -a CielFox -i "$C/grafica/icona.svg" "CielFox ha bisogno di LibreWolf" \
        "Installalo con: sudo pacman -S librewolf (dai repository ufficiali, ~98 MB)" 2>/dev/null
    echo "CielFox ha bisogno di LibreWolf: sudo pacman -S librewolf" >&2
    exit 1
fi
case "${1:-}" in
    --verifica) verifica; exit $? ;;
    --privato|--privata|--private|--incognito)
        shift
        exec "$B" --profile "$P" --name CielFox --class CielFox --private-window "$@" ;;
esac
exec "$B" --profile "$P" --name CielFox --class CielFox "$@"
