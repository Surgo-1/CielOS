#!/bin/sh
# CielFox: il browser di CielOS (LibreWolf con il profilo di CielFox, Ciel nella barra laterale, l'icona sua).
# A ogni avvio rimette le impostazioni del profilo e l'estensione aggiornata; il ponte con Ciel è registrato qui.
C="$HOME/cielos/cielfox"
P="${CIELFOX_PROFILO:-$HOME/.local/share/cielfox/profilo}"
mkdir -p "$P/extensions" "$P/chrome"
cp "$C/profilo/user.js" "$P/user.js"
for f in userChrome.css userContent.css; do [ -f "$C/profilo/$f" ] && cp "$C/profilo/$f" "$P/chrome/$f"; done
python3 "$C/profilo/barra.py" "$P" 2>/dev/null     # il bottone di Ciel in vista, una volta sola
# l'estensione impacchettata (solo se è cambiata)
X="$P/extensions/ciel@cielos.xpi"
if [ ! -f "$X" ] || [ -n "$(find "$C/estensione" -newer "$X" -type f | head -1)" ]; then
    rm -f "$X"; (cd "$C/estensione" && zip -qr -X "$X" . -x '*.swp')
fi
# il ponte: registrato per LibreWolf (e per Firefox, se un giorno firmiamo l'estensione)
for d in "$HOME/.librewolf/native-messaging-hosts" "$HOME/.config/librewolf/native-messaging-hosts" \
         "$HOME/.mozilla/native-messaging-hosts" "$HOME/.config/mozilla/native-messaging-hosts"; do
    mkdir -p "$d"
    printf '{"name":"cielfox","description":"Il ponte di CielFox con Ciel","path":"%s","type":"stdio","allowed_extensions":["ciel@cielos"]}\n' \
        "$C/ponte/cielfox_ponte.py" > "$d/cielfox.json"
done
# solo LibreWolf: il Firefox normale non accetta l'estensione di Ciel (non è firmata da Mozilla) e si porta dietro
# telemetria e notizie. Niente ripieghi silenziosi (14/10: era partito Firefox).
B=$(command -v librewolf)
if [ -z "$B" ]; then
    notify-send -a CielFox -i "$C/grafica/icona.svg" "CielFox ha bisogno di LibreWolf" \
        "Installalo con: sudo pacman -S librewolf (dai repository ufficiali, ~98 MB)" 2>/dev/null
    echo "CielFox ha bisogno di LibreWolf: sudo pacman -S librewolf" >&2
    exit 1
fi
exec "$B" --profile "$P" --name CielFox --class CielFox "$@"
