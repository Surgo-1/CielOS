#!/bin/sh
# Il monitor di sistema di CielOS (la finestra): processore core per core, memoria, scheda video, dischi, rete,
# processi, sensori. Il motore è cielmonitor.
R=${CIELOS_DIR:-$(dirname "$(readlink -f "$0")")/..}
# ciel-monitor [panoramica|processi|sensori]: apre su quella pagina
case "${1:-}" in processi) export MONITOR_PAGINA=1 ;; sensori) export MONITOR_PAGINA=2 ;; esac
exec qs -n -p "$R/app/monitor"
