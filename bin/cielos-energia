#!/usr/bin/env python3
"""La batteria di CielOS, gestita da sola.

  cielos-energia                il servizio: quando stacchi la presa mette il profilo «risparmio»; quando la
                                ricolleghi rimette quello di prima, ma solo se nel frattempo non l'hai cambiato tu
  cielos-energia stato [--json] batteria, presa e profilo di adesso
  cielos-energia applica        applica subito la scelta giusta (per gli script e le prove)
  cielos-energia --aiuto        questa guida

Niente sondaggi: si ascolta UPower sul bus di sistema e si agisce solo quando cambia qualcosa. Su un PC senza
batteria il servizio non parte (ConditionPathExistsGlob nel file .service). Il profilo si cambia con
power-profiles-daemon, lo stesso delle Impostazioni → Energia.
"""
import json, os, shutil, subprocess, sys
from datetime import datetime
from pathlib import Path

SUPPLY = Path(os.environ.get("CIELOS_POWER_SUPPLY", "/sys/class/power_supply"))
STATO = Path(os.environ.get("XDG_STATE_HOME", str(Path.home() / ".local/state"))) / "cielos"
FILE = STATO / "energia.json"
PROFILI = {"power-saver": "risparmio", "balanced": "bilanciato", "performance": "prestazioni"}
AIUTO = ("aiuto", "--aiuto", "--help", "-h", "help")


def _leggi(percorso):
    try:
        return percorso.read_text().strip()
    except OSError:
        return ""


def batterie(base=SUPPLY):
    """Le batterie presenti (di solito BAT0; su qualche portatile BAT1)."""
    return sorted(base.glob("BAT*"))


def su_batteria(base=SUPPLY):
    """True se il PC va a batteria, False se è alla presa, None se non c'è una batteria.

    Prima si guarda l'alimentatore (AC, ACAD, ADP…); se il firmware non lo espone, lo dice la batteria.
    """
    for ac in sorted(base.glob("A[CD]*")):
        v = _leggi(ac / "online")
        if v:
            return v == "0"
    for b in batterie(base):
        stato = _leggi(b / "status").lower()
        if stato == "discharging":
            return True
        if stato in ("charging", "full", "not charging"):
            return False
    return None


def profilo():
    """Il profilo energetico attuale, o None se power-profiles-daemon non c'è."""
    if not shutil.which("powerprofilesctl"):
        return None
    try:
        r = subprocess.run(["powerprofilesctl", "get"], capture_output=True, text=True, timeout=5)
    except (OSError, subprocess.SubprocessError):
        return None
    return r.stdout.strip() or None


def imposta(nome):
    """Cambia profilo; False se power-profiles-daemon non c'è o rifiuta."""
    if not shutil.which("powerprofilesctl"):
        return False
    try:
        subprocess.run(["powerprofilesctl", "set", nome], capture_output=True, text=True,
                       timeout=10, check=True)
        return True
    except (OSError, subprocess.SubprocessError):
        return False


def _leggi_stato():
    """Il profilo da rimettere quando si torna alla presa (scritto quando si stacca)."""
    try:
        prima = json.loads(FILE.read_text()).get("prima")
        return prima if prima in PROFILI else None
    except (OSError, ValueError):
        return None


def _scrivi_stato(prima=None):
    try:
        STATO.mkdir(parents=True, exist_ok=True)
        if prima:
            tmp = FILE.with_suffix(".tmp")
            tmp.write_text(json.dumps({"prima": prima}) + "\n")
            os.replace(tmp, FILE)
        elif FILE.exists():
            FILE.unlink()
    except OSError:
        pass


def _nota(testo):
    """Una riga nel registro, solo quando succede qualcosa (niente scritture a vuoto)."""
    try:
        STATO.mkdir(parents=True, exist_ok=True)
        with (STATO / "energia.log").open("a") as f:
            f.write(f"{datetime.now():%F %T} {testo}\n")
    except OSError:
        pass


def transizione(on_battery):
    """Adatta il profilo a un cambio presa/batteria. Restituisce il profilo che dovrebbe essere attivo.

    Non comanda se hai scelto tu «prestazioni» (o se il profilo è già quello giusto): il risparmio non deve
    sovrascrivere una scelta esplicita. Tornando alla presa rimette solo il profilo salvato e solo se è ancora
    «risparmio», così una tua modifica a batteria resta tua.
    """
    attuale = profilo()
    if attuale is None:
        return None
    prima = _leggi_stato()
    if on_battery:
        if attuale == "balanced":
            _scrivi_stato(attuale)
            if imposta("power-saver"):
                _nota("presa staccata: profilo risparmio")
        return "power-saver" if attuale == "balanced" else attuale
    if prima and attuale == "power-saver":
        if imposta(prima):
            _scrivi_stato(None)
            _nota(f"presa collegata: profilo {PROFILI.get(prima, prima)}")
        return prima
    return attuale


def stato():
    """Cosa vede il comando «stato»: batteria, carica e profilo."""
    b = batterie()
    carica = None
    if b:
        v = _leggi(b[0] / "capacity")
        carica = int(v) if v.isdigit() else None
    return {"batteria": su_batteria(), "presente": bool(b), "carica": carica,
            "stato_batteria": _leggi(b[0] / "status") if b else "",
            "profilo": profilo()}


def avvia():
    """Il servizio: ascolta UPower e chiama transizione() solo quando cambia la presa."""
    base = SUPPLY
    if not batterie(base):
        return 0
    try:
        from gi.repository import Gio, GLib
    except ImportError:
        _nota("python-gobject non c'è: il profilo non segue la batteria")
        return 0

    def cambiato(conn, sender, path, iface, signal, params):
        try:
            changed = params.unpack()[1]
            if "OnBattery" in changed:
                transizione(bool(changed["OnBattery"]))
        except Exception as e:                      # un segnale strano non deve fermare il servizio
            _nota(f"segnale UPower non capito: {e}")

    try:
        bus = Gio.bus_get_sync(Gio.BusType.SYSTEM, None)
        bus.signal_subscribe("org.freedesktop.UPower", "org.freedesktop.DBus.Properties",
                             "PropertiesChanged", "/org/freedesktop/UPower", None,
                             Gio.DBusSignalFlags.NONE, cambiato)
    except Exception as e:                          # niente UPower (o bus chiuso): meglio non fare danni
        _nota(f"UPower non disponibile: {e}")
        return 0
    transizione(su_batteria(base))                   # all'avvio: se sei a batteria, risparmio
    GLib.MainLoop().run()
    return 0


def esegui(args):
    if args and args[0] in AIUTO:
        print(__doc__)
        return 0
    if not args:
        return avvia()
    cmd = args[0]
    if cmd == "stato":
        s = stato()
        if "--json" in args:
            print(json.dumps({"ok": True, **s}, ensure_ascii=False))
        elif not s["presente"]:
            print("Nessuna batteria: questo PC va a corrente.")
        else:
            nome = PROFILI.get(s["profilo"] or "", s["profilo"] or "sconosciuto")
            presa = "a batteria" if s["batteria"] else "alla presa" if s["batteria"] is False else "stato sconosciuto"
            print(f"Batteria {s['carica'] if s['carica'] is not None else '?'}% ({s['stato_batteria'] or '?'}), "
                  f"{presa}; profilo {nome}.")
        return 0
    if cmd == "applica":
        on = su_batteria()
        if on is None:
            print("Nessuna batteria: non c'è niente da applicare.")
            return 0
        p = transizione(on)
        print(f"Profilo: {PROFILI.get(p or '', p or 'sconosciuto')}.")
        return 0 if p else 1
    print(__doc__, file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(esegui(sys.argv[1:]))
