#!/usr/bin/env python3
"""cielos: il comando di CielOS (come «omarchy»). Tutto quello che si fa dalle Impostazioni o chiedendo a Ciel,
anche dal terminale.

  cielos aggiorna            aggiorna il sistema: l'ondata già provata (con l'elenco e le notizie di Arch prima),
                             la tua password nella finestra del guardiano; se qualcosa si rompe torna indietro da solo
  cielos ritorna             rimette il sistema com'era prima dell'ultimo aggiornamento (dal prossimo avvio)
  cielos medico [ripara]     la visita del PC (e le riparazioni)
  cielos plugin …            i plugin (cielplugin: elenco, installa NOME, togli NOME)
  cielos hardware            cosa serve a questo PC (driver, firmware)
  cielos versione            la versione di CielOS e dell'ondata
  cielos segnala ["TESTO"]   ti chiede di raccontare il problema, raccoglie in un file quello che serve a capirlo
                             (hardware, audio, errori, crash di Hyprland, l'avvio prima) e, se vuoi, lo manda su
                             GitHub a chi sviluppa CielOS
  cielos errore "TESTO"      cosa vuol dire un errore (incolla il messaggio) e cosa fare; senza testo: tutti
  cielos wiki [PAGINA]       la guida di CielOS (nel riquadro, Super+A → Guida; senza la shell: nel terminale)
Anche in inglese: update, rollback, doctor, version, report, error, help."""
import json, os, shutil, subprocess, sys
try:
    import readline  # noqa: F401  (le domande: frecce, Home/Fine, cronologia; senza, le frecce scrivono «^[[D»)
except ImportError:
    pass
from pathlib import Path

RADICE = Path(os.environ.get("CIELOS_DIR") or Path(__file__).resolve().parent.parent)
BIN = RADICE / "bin"
sys.path.insert(0, str(RADICE / "lingua"))
from lingua import tr
SINONIMI = {"update": "aggiorna", "upgrade": "aggiorna", "rollback": "ritorna", "doctor": "medico",
            "version": "versione", "report": "segnala", "error": "errore", "guide": "wiki", "help": "aiuto", "-h": "aiuto", "--help": "aiuto", "status": "versione"}


def guardiano(azione, parametri):
    import gi
    gi.require_version("Gio", "2.0")
    from gi.repository import Gio, GLib
    bus = Gio.bus_get_sync(Gio.BusType.SYSTEM, None)
    try:
        r = bus.call_sync("org.cielos.Guardiano", "/org/cielos/Guardiano", "org.cielos.Guardiano1", "Esegui",
                          GLib.Variant("(ss)", (azione, json.dumps(parametri))), GLib.VariantType("(s)"),
                          Gio.DBusCallFlags.NONE, 3600 * 1000, None)
    except GLib.Error as e:
        return {"ok": False, "messaggio": tr("Il guardiano non risponde: %1", e.message)}
    return json.loads(r.unpack()[0])


def si(domanda):
    try:
        return input(f"{domanda} {tr('[S/n]')} ").strip().lower() in ("", "s", "si", "sì", "y", "yes")
    except (EOFError, KeyboardInterrupt):
        print()
        return False


def aggiorna():
    parametri = {}
    try:
        o = json.loads(subprocess.run([str(BIN / "cielondate"), "controlla", "--json"], capture_output=True,
                                      text=True, timeout=300).stdout)
    except (OSError, ValueError, subprocess.TimeoutExpired):
        o = {}
    if o.get("attive"):
        print(o.get("messaggio", ""))
        if not o.get("pronta"):
            return 0
        for c in o.get("pacchetti", [])[:12]:
            print(f"  {'!' if c['delicato'] else ' '} {c['nome']:<28} {c['da']} → {c['a']}")
        if len(o.get("pacchetti", [])) > 12:
            print("    " + tr("… e altri %1", len(o['pacchetti']) - 12))
        for n in o.get("notizie") or []:
            print("  " + tr("Notizia di Arch: «%1» %2", n.get('titolo'), n.get('link', '')))
        if o.get("notizie"):
            print("  " + tr("Se una notizia dice di fare qualcosa a mano, leggila prima di continuare."))
        parametri = {"ondata": o["proposta"]}
    if not si(tr("Aggiorno? (il guardiano ti chiede la password)")):
        return 1
    print(tr("Aggiorno… (fa un'istantanea prima: se dopo il PC non parte bene, torna indietro da solo)"), flush=True)
    r = guardiano("aggiorna", parametri)
    print(r.get("messaggio") or r.get("frase") or (tr("Fatto.") if r.get("ok") else tr("Non riuscito.")))
    return 0 if r.get("ok") else 1


def ritorna():
    if not si(tr("Rimetto il sistema com'era prima dell'ultimo aggiornamento (vale dal prossimo avvio)?")):
        return 1
    r = guardiano("ritorna", {})
    print(r.get("messaggio") or r.get("frase") or (tr("Fatto.") if r.get("ok") else tr("Non riuscito.")))
    return 0 if r.get("ok") else 1


def versione():
    q = subprocess.run(["pacman", "-Q", "cielos", "ciel-assistente"], capture_output=True, text=True).stdout.strip()
    print(q or tr("CielOS da sviluppo (%1)", RADICE), flush=True)
    subprocess.run([str(BIN / "cielondate"), "stato"])
    return 0


def racconto(args):
    """il problema raccontato da chi segnala: una riga (il titolo) e poi quello che è successo, su più righe.
    Da «cielos segnala "testo"» o, nel terminale, chiesto qui; senza terminale e senza testo: niente."""
    if args:
        t = " ".join(args).strip()
        return t.splitlines()[0][:120], t
    if not sys.stdin.isatty():
        return "", ""
    try:
        print(tr("Prima raccontami il problema: lo legge chi sviluppa CielOS, insieme ai registri."))
        titolo = input(tr("In una riga, qual è il problema? ")).strip()
        print(tr("Cosa è successo? Cosa stavi facendo, cosa ti aspettavi e cosa è successo invece, da quando succede…"))
        print(tr("(scrivi quante righe vuoi; una riga vuota per finire)"))
        righe = []
        while True:
            r = input("  ")
            if not r.strip():
                break
            righe.append(r)
    except (EOFError, KeyboardInterrupt):
        print()
        return "", ""
    return titolo[:120], "\n".join(righe).strip()


def segnala(args=()):
    import re, socket, time
    out = Path.home() / f"{tr('segnalazione-cielos')}-{time.strftime('%Y%m%d-%H%M')}.txt"
    parti = []
    titolo, storia = racconto(list(args))
    if titolo or storia:
        parti.append("\n===== il problema (scritto da chi segnala) =====\n" + (titolo or "…") + ("\n\n" + storia if storia and storia != titolo else ""))

    def sezione(titolo, *cmd, timeout=60):
        try:
            r = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
            testo = (r.stdout + ("\n" + r.stderr if r.stderr.strip() else "")).strip()
        except (OSError, subprocess.TimeoutExpired) as e:
            testo = tr("(non riuscito: %1)", e)
        parti.append(f"\n===== {titolo} =====\n{testo}")
        print(f"  {tr(titolo)}", flush=True)

    print(tr("Raccolgo:"), flush=True)
    sezione("versione", "sh", "-c", "pacman -Q cielos ciel-assistente linux mesa hyprland pipewire wireplumber 2>&1; uname -a")
    sezione("ondate", str(BIN / "cielondate"), "stato")
    sezione("hardware (pci)", "lspci", "-nnk")
    sezione("hardware (usb)", "lsusb")
    sezione("cosa serve a questo PC", str(BIN / "cielos-hardware"))
    sezione("medico", str(BIN / "cielmedico"), timeout=120)
    sezione("audio", "wpctl", "status")
    sezione("audio (sorgenti e uscite)", "sh", "-c", "pactl list short sinks; echo; pactl list short sources; echo; "
            "pactl get-default-sink; pactl get-default-source")
    sezione("servizi dell'utente", "systemctl", "--user", "--no-pager", "--state=failed,activating", "list-units")
    sezione("schermi", "hyprctl", "monitors")
    # la condivisione dello schermo (Discord, OBS): con che scheda disegna Hyprland, cosa dice il portale, la sessione
    sezione("condivisione dello schermo", "sh", "-c",
            "ls /sys/class/drm | grep -E '^card[0-9]+$'; "
            "for p in $(pidof Hyprland); do tr '\\0' '\\n' < /proc/$p/environ | grep -E '^(AQ_|WLR_|XDG_CURRENT)'; done; "
            "grep -E 'schede video' \"${XDG_STATE_HOME:-$HOME/.local/state}/cielos/sessione.log\" 2>/dev/null | tail -3; echo; "
            "journalctl --user -b --no-pager -q -n 300 -u xdg-desktop-portal-hyprland -u xdg-desktop-portal 2>/dev/null | grep -v 'Got interface' | tail -40")
    sezione("errori di questo avvio", "journalctl", "-b", "-p", "3", "--no-pager", "-q", "-n", "200")
    sezione("avvio precedente: errori", "journalctl", "-b", "-1", "-p", "3", "--no-pager", "-q", "-n", "150")
    sezione("avvio precedente: gli ultimi messaggi (cosa è successo prima che si fermasse)",
            "journalctl", "-b", "-1", "--no-pager", "-q", "-n", "80")
    sezione("avvii recenti", "journalctl", "--list-boots", "--no-pager", "-q")
    crash = sorted(Path.home().glob(".cache/hyprland/hyprlandCrashReport*.txt"), key=lambda f: f.stat().st_mtime)
    if crash:
        parti.append(f"\n===== crash di Hyprland ({len(crash)}; l'ultimo: {crash[-1].name}) =====\n" +
                     crash[-1].read_text(errors="replace")[:6000])
    log = Path("/var/log/cielos-installa.log")
    if log.exists():
        try:
            parti.append("\n===== installazione (fine) =====\n" + "\n".join(log.read_text(errors="replace").splitlines()[-40:]))
        except OSError:
            pass
    testo = "\n".join(parti)
    # niente dati personali: il nome dell'utente e del PC diventano segnaposto
    for vero, finto in ((os.environ.get("USER", ""), "UTENTE"), (socket.gethostname(), "PC")):
        if vero and len(vero) > 2:
            testo = re.sub(re.escape(vero), finto, testo)
    testo = re.sub(r"\b([0-9a-f]{2}:){5}[0-9a-f]{2}\b", "xx:xx:xx:xx:xx:xx", testo, flags=re.I)   # indirizzi MAC
    # la guida agli errori su quello che si è raccolto: cosa riconosce (aiuta chi legge, e te subito)
    noti = trova_errori(testo)
    if noti:
        testo += "\n\n===== cosa riconosce la guida agli errori =====\n" + "\n".join(
            f"- {v['id']}: {v['it']['titolo']}" for v in noti[:8])
    out.write_text(f"Segnalazione di CielOS, {time.strftime('%d/%m/%Y %H:%M')}\n" + testo + "\n")
    print("\n" + tr("Fatto: %1", out))
    print(tr("Dentro non ci sono password né il tuo nome; c'è il tuo racconto, l'elenco dell'hardware e degli errori."))
    if noti:
        print("\n" + tr("La guida agli errori riconosce qualcosa (dettagli: «cielos errore» con il testo):"))
        for v in noti[:4]:
            l = lingua_voce(v)
            print(f"  ■ {l['titolo']}: {l['fare']}")
    if sys.stdin.isatty() and si("\n" + tr("La mando su GitHub, a chi sviluppa CielOS? (serve un account GitHub, gratis)")):
        return issue(out, testo, titolo, storia)        # il testo già ripulito (niente nome, PC, MAC)
    print(tr("Puoi anche mandarla a mano (per esempio come file su Discord)."))
    return 0


REPO_ISSUE = "https://github.com/Surgo-1/CielOS/issues/new"


def issue(file, testo, cosa="", storia=""):
    """apre nel browser una issue già compilata (il problema raccontato + il riassunto); il file completo lo trascini
    tu dentro"""
    import urllib.parse
    if not cosa:
        try:
            cosa = input(tr("In una riga: cosa non va? ")).strip()
        except (EOFError, KeyboardInterrupt):
            print()
            return 1
    def pezzo(titolo, righe):
        for p in testo.split("\n===== ")[1:]:
            if p.startswith(f"{titolo} ====="):
                corpo = p.split("=====\n", 1)[-1].strip().splitlines()
                return f"**{titolo}**\n```\n" + "\n".join(corpo[-righe:])[:1500] + "\n```\n"
        return ""
    corpo = (f"### {tr('Cosa succede')}\n{cosa or '…'}\n\n" + (f"{storia[:2500]}\n\n" if storia and storia != cosa else "") +
             f"### {tr('Il file completo')}\n" + tr("Trascina qui sotto il file %1 (è nella tua cartella home).", file.name) + "\n\n"
             f"### {tr('Riassunto')}\n" + pezzo("versione", 10) + pezzo("medico", 20) + pezzo("errori di questo avvio", 15))
    titolo = "[segnala] " + (cosa or tr("problema"))
    # con gh già collegato a GitHub la issue parte da qui, file compreso nel testo (niente browser)
    if shutil.which("gh") and subprocess.run(["gh", "auth", "status"], capture_output=True).returncode == 0:
        completo = corpo.split(f"### {tr('Il file completo')}")[0] + f"### {tr('Segnalazione completa')}\n```\n{testo[-60000:]}\n```\n"
        r = subprocess.run(["gh", "issue", "create", "-R", REPO_ISSUE.split("github.com/")[1].rsplit("/issues", 1)[0],
                            "--title", titolo, "--body-file", "-"], input=completo, text=True, capture_output=True)
        if r.returncode == 0:
            print(tr("Mandata: %1", r.stdout.strip()))
            return 0
    # nel browser: GitHub resta a caricare all'infinito se l'indirizzo è lungo (15/10: «caricamento infinito»), quindi
    # solo il racconto (corto); il resto è nel file da trascinare
    url = REPO_ISSUE + "?" + urllib.parse.urlencode({"title": titolo, "body": corpo})
    if len(url) > 1800:
        breve = (f"### {tr('Cosa succede')}\n{cosa or '…'}\n\n" + (f"{storia[:600]}\n\n" if storia and storia != cosa else "") +
                 f"### {tr('Il file completo')}\n" + tr("Trascina qui sotto il file %1 (è nella tua cartella home).", file.name))
        url = REPO_ISSUE + "?" + urllib.parse.urlencode({"title": titolo, "body": breve})
    subprocess.Popen(["xdg-open", url], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    subprocess.Popen([str(BIN / "ciel-file"), str(file.parent)], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    print(tr("Si apre GitHub nel browser, già compilato: entra col tuo account, trascina il file %1 nella casella "
             "(te l'ho aperto in File) e premi «Create»/«Crea».", file.name))
    print(tr("Se la pagina resta a caricare: entra prima su github.com, poi rilancia «cielos segnala»; oppure manda il file a mano."))
    return 0


WIKI = RADICE / "wiki"


def errori_voci():
    try:
        return json.loads((WIKI / "errori.json").read_text())["voci"]
    except (OSError, ValueError, KeyError):
        return []


def trova_errori(testo):
    """le voci della guida che riconoscono il testo (le più precise prima: quelle con più schemi trovati)"""
    import re
    punti = []
    for v in errori_voci():
        n = sum(1 for sc in v["cerca"] if re.search(sc, testo, re.I | re.M))
        if n:
            punti.append((n, v))
    return [v for _, v in sorted(punti, key=lambda x: -x[0])]


def lingua_voce(v):
    from lingua import LINGUA
    return v.get(LINGUA) or v["it"]


def errore(args):
    js = "--json" in args
    testo = " ".join(a for a in args if a != "--json").strip()
    if not testo and not sys.stdin.isatty():
        testo = sys.stdin.read()                    # anche: comando 2>&1 | cielos errore
    voci = trova_errori(testo) if testo else errori_voci()
    if js:
        print(json.dumps([{"id": v["id"], "sezione": v["sezione"], **lingua_voce(v)} for v in voci], ensure_ascii=False))
        return 0 if voci else 1
    if testo and not voci:
        print(tr("Non conosco questo errore. Prova «cielos medico», chiedi a Ciel, o manda «cielos segnala»."))
        return 1
    for v in voci[:3] if testo else voci:
        l = lingua_voce(v)
        print(f"■ {l['titolo']}\n  {tr('Cosa significa')}: {l['significa']}\n  {tr('Cosa fare')}: {l['fare']}\n")
    return 0


def errori_markdown():
    """wiki/12-errori.md (generata da errori.json, per GitHub e per chi legge i file)"""
    righe = ["# Errori", "", "Cosa significa ogni errore e cosa fare. Per cercarne uno: incollalo in Super+A → Guida → "
             "*Cosa vuol dire?*, oppure `cielos errore \"testo dell'errore\"`.", "",
             "<!-- generata da «cielos errore --markdown» da wiki/errori.json: non modificarla a mano -->", ""]
    sezione = None
    for v in errori_voci():
        if v["sezione"] != sezione:
            sezione = v["sezione"]
            righe += [f"## {sezione}", ""]
        l = v["it"]
        righe += [f'<a id="{v["id"]}"></a>', f"### {l['titolo']}", "", f"**Cosa significa.** {l['significa']}", "",
                  f"**Cosa fare.** {l['fare']}", ""]
    return "\n".join(righe)


def wiki(args):
    pagine = sorted(WIKI.glob("*.md"))
    nome = args[0] if args else ""
    scelta = next((p for p in pagine if nome and nome.lower() in p.stem.lower()), pagine[0] if pagine else None)
    if not scelta:
        print(tr("La guida non c'è (%1).", WIKI))
        return 1
    # con la shell di CielOS: si apre nel riquadro; senza (terminale, altra sessione): si stampa
    r = subprocess.run(["qs", "-c", "ciel", "ipc", "call", "riquadro", "guida", scelta.stem], capture_output=True)
    if r.returncode != 0 or not os.environ.get("WAYLAND_DISPLAY"):
        print(scelta.read_text())
        if not args:
            print("\n" + tr("Le pagine: %1", ", ".join(p.stem for p in pagine)))
    return 0


def main():
    a = sys.argv[1:]
    cmd = SINONIMI.get(a[0], a[0]) if a else "aiuto"
    if cmd == "aiuto":
        print(tr(__doc__))
        return 0
    if cmd == "aggiorna":
        return aggiorna()
    if cmd == "ritorna":
        return ritorna()
    if cmd == "versione":
        return versione()
    if cmd == "segnala":
        return segnala(a[1:])
    if cmd == "errore":
        if "--markdown" in a:
            print(errori_markdown())
            return 0
        return errore(a[1:])
    if cmd == "wiki":
        return wiki(a[1:])
    if cmd == "medico":
        os.execv(str(BIN / "cielmedico"), ["cielmedico", *a[1:]])
    if cmd == "plugin":
        os.execv(str(BIN / "cielplugin"), ["cielplugin", *a[1:]])
    if cmd == "hardware":
        os.execv(str(BIN / "cielos-hardware"), ["cielos-hardware", *a[1:]])
    print(tr("cielos: non conosco «%1».", a[0]) + "\n")
    print(tr(__doc__))
    return 2


if __name__ == "__main__":
    sys.exit(main())
