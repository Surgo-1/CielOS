#!/usr/bin/env python3
"""cielos: il comando di CielOS (come «omarchy»). Tutto quello che si fa dalle Impostazioni o chiedendo a Ciel,
anche dal terminale.

  cielos aggiorna            aggiorna il sistema: l'ondata già provata (con l'elenco e le notizie di Arch prima),
                             la tua password nella finestra del guardiano; se qualcosa si rompe torna indietro da solo
  cielos ritorna             rimette il sistema com'era prima dell'ultimo aggiornamento (dal prossimo avvio)
  cielos medico [ripara]     la visita del PC (e le riparazioni)
  cielos plugin …            i plugin (cielplugin: elenco, installa NOME, togli NOME)
  cielos hardware            cosa serve a questo PC (driver, firmware)
  cielos versione            la versione di CielOS e dell'ondata
  cielos segnala             raccoglie in un file quello che serve a capire un problema (hardware, audio, errori,
                             crash di Hyprland, l'avvio prima): lo mandi a chi sviluppa CielOS, al posto delle foto
Anche in inglese: update, rollback, doctor, version, report, help."""
import json, os, subprocess, sys
from pathlib import Path

RADICE = Path(os.environ.get("CIELOS_DIR") or Path(__file__).resolve().parent.parent)
BIN = RADICE / "bin"
sys.path.insert(0, str(RADICE / "lingua"))
from lingua import tr
SINONIMI = {"update": "aggiorna", "upgrade": "aggiorna", "rollback": "ritorna", "doctor": "medico",
            "version": "versione", "report": "segnala", "help": "aiuto", "-h": "aiuto", "--help": "aiuto", "status": "versione"}


def guardiano(azione, parametri):
    import gi
    gi.require_version("Gio", "2.0")
    from gi.repository import Gio, GLib
    bus = Gio.bus_get_sync(Gio.BusType.SYSTEM, None)
    try:
        r = bus.call_sync("org.cielos.Guardiano", "/org/cielos/Guardiano", "org.cielos.Guardiano1", "Esegui",
                          GLib.Variant("(ss)", (azione, json.dumps(parametri))), GLib.VariantType("(s)"),
                          Gio.DBusCallFlags.NONE, 3600 * 1000, None)
    except GLib.Error as e:
        return {"ok": False, "messaggio": tr("Il guardiano non risponde: %1", e.message)}
    return json.loads(r.unpack()[0])


def si(domanda):
    try:
        return input(f"{domanda} {tr('[S/n]')} ").strip().lower() in ("", "s", "si", "sì", "y", "yes")
    except (EOFError, KeyboardInterrupt):
        print()
        return False


def aggiorna():
    parametri = {}
    try:
        o = json.loads(subprocess.run([str(BIN / "cielondate"), "controlla", "--json"], capture_output=True,
                                      text=True, timeout=300).stdout)
    except (OSError, ValueError, subprocess.TimeoutExpired):
        o = {}
    if o.get("attive"):
        print(o.get("messaggio", ""))
        if not o.get("pronta"):
            return 0
        for c in o.get("pacchetti", [])[:12]:
            print(f"  {'!' if c['delicato'] else ' '} {c['nome']:<28} {c['da']} → {c['a']}")
        if len(o.get("pacchetti", [])) > 12:
            print("    " + tr("… e altri %1", len(o['pacchetti']) - 12))
        for n in o.get("notizie") or []:
            print("  " + tr("Notizia di Arch: «%1» %2", n.get('titolo'), n.get('link', '')))
        if o.get("notizie"):
            print("  " + tr("Se una notizia dice di fare qualcosa a mano, leggila prima di continuare."))
        parametri = {"ondata": o["proposta"]}
    if not si(tr("Aggiorno? (il guardiano ti chiede la password)")):
        return 1
    print(tr("Aggiorno… (fa un'istantanea prima: se dopo il PC non parte bene, torna indietro da solo)"), flush=True)
    r = guardiano("aggiorna", parametri)
    print(r.get("messaggio") or r.get("frase") or (tr("Fatto.") if r.get("ok") else tr("Non riuscito.")))
    return 0 if r.get("ok") else 1


def ritorna():
    if not si(tr("Rimetto il sistema com'era prima dell'ultimo aggiornamento (vale dal prossimo avvio)?")):
        return 1
    r = guardiano("ritorna", {})
    print(r.get("messaggio") or r.get("frase") or (tr("Fatto.") if r.get("ok") else tr("Non riuscito.")))
    return 0 if r.get("ok") else 1


def versione():
    q = subprocess.run(["pacman", "-Q", "cielos", "ciel-assistente"], capture_output=True, text=True).stdout.strip()
    print(q or tr("CielOS da sviluppo (%1)", RADICE), flush=True)
    subprocess.run([str(BIN / "cielondate"), "stato"])
    return 0


def segnala():
    import re, socket, time
    out = Path.home() / f"{tr('segnalazione-cielos')}-{time.strftime('%Y%m%d-%H%M')}.txt"
    parti = []

    def sezione(titolo, *cmd, timeout=60):
        try:
            r = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
            testo = (r.stdout + ("\n" + r.stderr if r.stderr.strip() else "")).strip()
        except (OSError, subprocess.TimeoutExpired) as e:
            testo = tr("(non riuscito: %1)", e)
        parti.append(f"\n===== {titolo} =====\n{testo}")
        print(f"  {tr(titolo)}", flush=True)

    print(tr("Raccolgo:"), flush=True)
    sezione("versione", "sh", "-c", "pacman -Q cielos ciel-assistente linux mesa hyprland pipewire wireplumber 2>&1; uname -a")
    sezione("ondate", str(BIN / "cielondate"), "stato")
    sezione("hardware (pci)", "lspci", "-nnk")
    sezione("hardware (usb)", "lsusb")
    sezione("cosa serve a questo PC", str(BIN / "cielos-hardware"))
    sezione("medico", str(BIN / "cielmedico"), timeout=120)
    sezione("audio", "wpctl", "status")
    sezione("audio (sorgenti e uscite)", "sh", "-c", "pactl list short sinks; echo; pactl list short sources; echo; "
            "pactl get-default-sink; pactl get-default-source")
    sezione("servizi dell'utente", "systemctl", "--user", "--no-pager", "--state=failed,activating", "list-units")
    sezione("schermi", "hyprctl", "monitors")
    sezione("errori di questo avvio", "journalctl", "-b", "-p", "3", "--no-pager", "-q", "-n", "200")
    sezione("avvio precedente: errori", "journalctl", "-b", "-1", "-p", "3", "--no-pager", "-q", "-n", "150")
    sezione("avvio precedente: gli ultimi messaggi (cosa è successo prima che si fermasse)",
            "journalctl", "-b", "-1", "--no-pager", "-q", "-n", "80")
    sezione("avvii recenti", "journalctl", "--list-boots", "--no-pager", "-q")
    crash = sorted(Path.home().glob(".cache/hyprland/hyprlandCrashReport*.txt"), key=lambda f: f.stat().st_mtime)
    if crash:
        parti.append(f"\n===== crash di Hyprland ({len(crash)}; l'ultimo: {crash[-1].name}) =====\n" +
                     crash[-1].read_text(errors="replace")[:6000])
    log = Path("/var/log/cielos-installa.log")
    if log.exists():
        try:
            parti.append("\n===== installazione (fine) =====\n" + "\n".join(log.read_text(errors="replace").splitlines()[-40:]))
        except OSError:
            pass
    testo = "\n".join(parti)
    # niente dati personali: il nome dell'utente e del PC diventano segnaposto
    for vero, finto in ((os.environ.get("USER", ""), "UTENTE"), (socket.gethostname(), "PC")):
        if vero and len(vero) > 2:
            testo = re.sub(re.escape(vero), finto, testo)
    testo = re.sub(r"\b([0-9a-f]{2}:){5}[0-9a-f]{2}\b", "xx:xx:xx:xx:xx:xx", testo, flags=re.I)   # indirizzi MAC
    out.write_text(f"Segnalazione di CielOS, {time.strftime('%d/%m/%Y %H:%M')}\n" + testo + "\n")
    print("\n" + tr("Fatto: %1", out) + "\n" + tr("Mandalo a chi sviluppa CielOS (per esempio come file su Discord)."))
    print(tr("Dentro non ci sono password né il tuo nome; c'è l'elenco dell'hardware e degli errori."))
    return 0


def main():
    a = sys.argv[1:]
    cmd = SINONIMI.get(a[0], a[0]) if a else "aiuto"
    if cmd == "aiuto":
        print(tr(__doc__))
        return 0
    if cmd == "aggiorna":
        return aggiorna()
    if cmd == "ritorna":
        return ritorna()
    if cmd == "versione":
        return versione()
    if cmd == "segnala":
        return segnala()
    if cmd == "medico":
        os.execv(str(BIN / "cielmedico"), ["cielmedico", *a[1:]])
    if cmd == "plugin":
        os.execv(str(BIN / "cielplugin"), ["cielplugin", *a[1:]])
    if cmd == "hardware":
        os.execv(str(BIN / "cielos-hardware"), ["cielos-hardware", *a[1:]])
    print(tr("cielos: non conosco «%1».", a[0]) + "\n")
    print(tr(__doc__))
    return 2


if __name__ == "__main__":
    sys.exit(main())
