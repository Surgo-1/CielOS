#!/bin/bash
# Il motore dell'installatore di CielOS (dalla ISO, da root): installa CielOS su un disco intero.
#   cielos-installa-sistema CONFIG.json
# CONFIG: {"disco": "/dev/nvme0n1", "utente": "luca", "nome": "Luca", "password_file": "/tmp/…", "host": "cielos",
#          "fuso": "Europe/Rome", "tastiera": "it", "lingua": "it_IT.UTF-8", "ciel": true,
#          "cifra": false, "cifra_file": "/tmp/…"}   (cifra: il disco con LUKS2, come l'opzione di Calamares in EndeavourOS)
# La password sta in un file (0600) che viene cancellato subito: mai sulla riga di comando.
# Il disco: GPT con 1 MiB «BIOS boot» (per i PC senza UEFI), 1 GiB EFI FAT32 (/boot: kernel e Limine) e il resto
# btrfs (sottovolumi @ e @home, compressione zstd; le istantanee di snapper in /.snapshots). Si avvia sia in UEFI sia
# in BIOS. I pacchetti: quelli di CielOS più SOLO i driver e il firmware di questo PC (cielos-hardware).
# Scrive «PASSO n/N testo» a ogni fase (la finestra dell'installatore le legge) e alla fine «FATTO» o «ERRORE …».
set -uo pipefail
CONF=${1:?config}
R=${CIELOS_DIR:-/usr/share/cielos}
REPO=${CIELOS_REPO:-/opt/cielos/repo}                 # il repository di CielOS sulla ISO
M=/mnt/cielos
LOG=/var/log/cielos-installa.log
exec > >(tee -a "$LOG") 2>&1
N=10
# i messaggi nella lingua scelta nell'installatore (lingua/lingua.sh; «t» senza il file resta in italiano)
. "$R/lingua/lingua.sh" 2>/dev/null || t() { local r=$1; shift; local i=1; for v in "$@"; do r=${r//%$i/$v}; i=$((i + 1)); done; printf '%s' "$r"; }
passo() { echo "PASSO $1/$N $(t "$2")"; }
muori() { echo "ERRORE $(t "$@")"; umount -R "$M" 2>/dev/null; cryptsetup close cielos_root 2>/dev/null; exit 1; }
[ "$(id -u)" = 0 ] || muori "serve root"
leggi() { python3 -c "import json,sys; v=json.load(open(sys.argv[1])).get(sys.argv[2], sys.argv[3] if len(sys.argv) > 3 else ''); print(str(v).lower() if isinstance(v, bool) else v)" "$CONF" "$@"; }
DISCO=$(leggi disco); UTENTE=$(leggi utente); NOME=$(leggi nome); PWF=$(leggi password_file)
HOST=$(leggi host cielos); FUSO=$(leggi fuso Europe/Rome); TAST=$(leggi tastiera it); LINGUA=$(leggi lingua it_IT.UTF-8)
[[ "$LINGUA" == it* ]] && LINGUA_CODICE=it || LINGUA_CODICE=en
CIEL=$(leggi ciel false)
CIFRA=$(leggi cifra false); CIFRA_FILE=$(leggi cifra_file)
if [ "$CIFRA" = true ]; then
    [ -s "$CIFRA_FILE" ] || muori "manca la frase segreta del disco"
    command -v cryptsetup >/dev/null || muori "manca cryptsetup per cifrare il disco"
fi
[ -b "$DISCO" ] || muori "il disco %1 non c'è" "$DISCO"
[[ "$UTENTE" =~ ^[a-z_][a-z0-9_-]{0,31}$ ]] || muori "nome utente non valido: %1" "$UTENTE"
[ -s "$PWF" ] || muori "manca la password"
PASSWORD=$(cat "$PWF"); rm -f "$PWF"
UEFI=0; [ -d /sys/firmware/efi ] && UEFI=1
part() { if [[ "$DISCO" =~ [0-9]$ ]]; then echo "${DISCO}p$1"; else echo "$DISCO$1"; fi; }
echo "CielOS su $DISCO ($([ $UEFI = 1 ] && echo UEFI || echo BIOS)), utente $UTENTE, $FUSO, tastiera $TAST, Ciel: $CIEL"

passo 1 "Preparo il disco"
grep -q "^$DISCO" /proc/mounts && umount -R "$(grep "^$DISCO" /proc/mounts | awk '{print $2}' | sort -r)" 2>/dev/null
swapoff -a 2>/dev/null
wipefs -af "$DISCO" >/dev/null || muori "non riesco a cancellare %1" "$DISCO"
sfdisk -q --wipe always "$DISCO" <<E || muori "partizioni non create"
label: gpt
size=1MiB, type=21686148-6449-6E6F-744E-656564454649, name="bios"
size=1GiB, type=C12A7328-F81F-11D2-BA4B-00A0C93EC93B, name="EFI"
type=0FC63DAF-8483-4772-8E79-3D69D8477DE4, name="cielos"
E
udevadm settle
# i resti di un vecchio file system nelle partizioni nuove (limine bios-install rifiuta la partizione BIOS se ne vede uno)
for i in 1 2 3; do wipefs -aq "$(part $i)" 2>/dev/null; done
mkfs.fat -F32 -n BOOT "$(part 2)" >/dev/null || muori "EFI non formattata"
RADICE="$(part 3)"                                   # dove va btrfs: la partizione, o il suo contenitore cifrato
if [ "$CIFRA" = true ]; then
    cryptsetup luksFormat --type luks2 --batch-mode --label cielos-cifrato --key-file "$CIFRA_FILE" "$(part 3)" \
        || muori "cifratura non riuscita"
    cryptsetup open --key-file "$CIFRA_FILE" "$(part 3)" cielos_root || muori "il disco cifrato non si apre"
    shred -u "$CIFRA_FILE" 2>/dev/null || rm -f "$CIFRA_FILE"
    RADICE=/dev/mapper/cielos_root
fi
mkfs.btrfs -f -L cielos "$RADICE" >/dev/null || muori "btrfs non formattato"

passo 2 "Creo i sottovolumi"
mkdir -p "$M"
mount "$RADICE" "$M" && btrfs subvolume create "$M/@" >/dev/null && btrfs subvolume create "$M/@home" >/dev/null && umount "$M" \
    || muori "sottovolumi non creati"
mount -o subvol=@,compress=zstd,noatime "$RADICE" "$M" || muori "mount di @"
mkdir -p "$M/home" "$M/boot"
mount -o subvol=@home,compress=zstd,noatime "$RADICE" "$M/home" || muori "mount di @home"
mount -o umask=0077 "$(part 2)" "$M/boot" || muori "mount di /boot"

passo 3 "Guardo l'hardware: solo i driver che servono a questo PC"
pacman -Sy --noconfirm >/dev/null 2>&1 || echo "   $(t "(elenco dei repository non aggiornato: lo controlla pacstrap)")"
HW=$(cielos-hardware --json)
HWPKG=$(echo "$HW" | python3 -c "import json,sys; print(' '.join(json.load(sys.stdin)['pacchetti']))")
HWSRV=$(echo "$HW" | python3 -c "import json,sys; print(' '.join(json.load(sys.stdin)['servizi']))")
echo "   $(t "per questo PC: %1" "$HWPKG")"

passo 4 "Installo il sistema (scarica i pacchetti: qualche minuto)"
PAC=/tmp/cielos-pacman.conf
cp /etc/pacman.conf "$PAC"
grep -q '^\[cielos\]' "$PAC" || printf '\n[cielos]\nSigLevel = Optional TrustAll\nServer = file://%s\n' "$REPO" >> "$PAC"
BASE=(base linux mkinitcpio btrfs-progs dosfstools limine sudo networkmanager cielos)
[ "$CIFRA" = true ] && BASE+=(cryptsetup)
[ $UEFI = 1 ] && BASE+=(efibootmgr)
[ "$CIEL" = true ] && BASE+=(ciel-assistente)
# shellcheck disable=SC2086
pacstrap -C "$PAC" -K "$M" "${BASE[@]}" $HWPKG || muori "pacstrap non riuscito (Internet? spazio?)"
genfstab -U "$M" >> "$M/etc/fstab"
# il repository di CielOS sul sistema nuovo: gli aggiornamenti arrivano da GitHub, firmati con la chiave di CielOS
# (/etc/pacman.d/cielos-mirrorlist); la copia della ISO resta in /var/lib/cielos/repo
mkdir -p "$M/var/lib/cielos/repo" && cp -a "$REPO"/. "$M/var/lib/cielos/repo/"
arch-chroot "$M" /usr/lib/cielos/cielos-repo

passo 5 "Lingua, ora, tastiera, nome del PC"
ln -sf "/usr/share/zoneinfo/$FUSO" "$M/etc/localtime"
arch-chroot "$M" hwclock --systohc 2>/dev/null
sed -i "s/^#\(${LINGUA%%.*}.UTF-8 UTF-8\)/\1/; s/^#\(en_US.UTF-8 UTF-8\)/\1/" "$M/etc/locale.gen"
arch-chroot "$M" locale-gen >/dev/null
echo "LANG=$LINGUA" > "$M/etc/locale.conf"
echo "KEYMAP=$TAST" > "$M/etc/vconsole.conf"
mkdir -p "$M/etc/X11/xorg.conf.d"
printf 'Section "InputClass"\n    Identifier "tastiera"\n    MatchIsKeyboard "on"\n    Option "XkbLayout" "%s"\nEndSection\n' "$TAST" \
    > "$M/etc/X11/xorg.conf.d/00-keyboard.conf"
echo "$HOST" > "$M/etc/hostname"
printf '127.0.0.1 localhost\n::1 localhost\n127.0.1.1 %s.localdomain %s\n' "$HOST" "$HOST" > "$M/etc/hosts"

passo 6 "Creo il tuo utente"
arch-chroot "$M" useradd -m -G wheel -c "$NOME" -s /usr/bin/fish "$UTENTE" || muori "utente non creato"
printf '%s:%s\n' "$UTENTE" "$PASSWORD" | arch-chroot "$M" chpasswd || muori "password non impostata"
unset PASSWORD
echo "%wheel ALL=(ALL:ALL) ALL" > "$M/etc/sudoers.d/10-wheel"; chmod 440 "$M/etc/sudoers.d/10-wheel"
H="$M/home/$UTENTE/.config/cielos"
mkdir -p "$H"
printf '{\n  "input": {"kb_layout": "%s"}\n}\n' "$TAST" > "$H/sistema.json"
[ "$CIEL" = true ] && touch "$H/ciel-da-installare"
arch-chroot "$M" chown -R "$UTENTE:$UTENTE" "/home/$UTENTE/.config"

passo 7 "Avvio: Limine"
UUID=$(blkid -s UUID -o value "$RADICE")
CMD="root=UUID=$UUID rootflags=subvol=@ rw quiet splash"
if [ "$CIFRA" = true ]; then
    # la frase segreta all'avvio: sd-encrypt (initramfs con systemd) o encrypt (con udev), dopo «block»; capiscono
    # ognuno la sua opzione (rd.luks.name / cryptdevice), l'altra la ignorano
    LUKS=$(blkid -s UUID -o value "$(part 3)")
    CMD="rd.luks.name=$LUKS=cielos_root cryptdevice=UUID=$LUKS:cielos_root root=/dev/mapper/cielos_root rootflags=subvol=@ rw quiet splash"
    install -d "$M/etc/mkinitcpio.conf.d"
    cat > "$M/etc/mkinitcpio.conf.d/cielos-cifra.conf" <<'H'
# CielOS: il disco è cifrato (LUKS): l'hook che chiede la frase segreta, subito dopo «block»
if [[ " ${HOOKS[*]} " != *" sd-encrypt "* && " ${HOOKS[*]} " != *" encrypt "* ]]; then
    if [[ " ${HOOKS[*]} " == *" systemd "* ]]; then _cifra=sd-encrypt; else _cifra=encrypt; fi
    _cielos=(); for _h in "${HOOKS[@]}"; do _cielos+=("$_h"); [[ $_h == block ]] && _cielos+=("$_cifra"); done
    HOOKS=("${_cielos[@]}"); unset _cielos _cifra _h
fi
H
fi
cat > "$M/boot/limine.conf" <<E
timeout: 3

/CielOS
    protocol: linux
    path: boot():/vmlinuz-linux
    cmdline: $CMD
    module_path: boot():/initramfs-linux.img

/CielOS (ripiego)
    protocol: linux
    path: boot():/vmlinuz-linux
    cmdline: $CMD
    module_path: boot():/initramfs-linux-fallback.img
E
mkdir -p "$M/boot/EFI/BOOT" "$M/etc/cielos"
echo limine-cielos > "$M/etc/cielos/avvio"          # Limine messo da CielOS: lo aggiorna l'hook cielos-limine
cp /usr/share/limine/BOOTX64.EFI "$M/boot/EFI/BOOT/BOOTX64.EFI"
cp /usr/share/limine/limine-bios.sys "$M/boot/"
limine bios-install "$DISCO" 1 >/dev/null || echo "   $(t "(avvio BIOS non installato: resta UEFI)")"
if [ $UEFI = 1 ]; then
    efibootmgr --create --disk "$DISCO" --part 2 --label "CielOS" --loader '\EFI\BOOT\BOOTX64.EFI' >/dev/null 2>&1 \
        || echo "   $(t "(voce UEFI non creata: parte lo stesso dal percorso di riserva)")"
fi

passo 8 "Configuro CielOS (login, rete, firewall, istantanee, aggiornamenti a ondate, logo all'avvio)"
arch-chroot "$M" cielos-sistema || muori "cielos-sistema non riuscito"
for s in $HWSRV; do arch-chroot "$M" systemctl enable "$s" >/dev/null 2>&1; done

passo 9 "Preparo l'initramfs"
arch-chroot "$M" mkinitcpio -P >/dev/null 2>&1 || muori "mkinitcpio non riuscito"

passo 10 "Finisco"
cp "$LOG" "$M/var/log/cielos-installa.log" 2>/dev/null
sync
umount -R "$M" || echo "   $(t "(smontaggio: riprova a riavviare)")"
[ "$CIFRA" = true ] && cryptsetup close cielos_root 2>/dev/null
echo "FATTO"
