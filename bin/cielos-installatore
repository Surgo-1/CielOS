#!/bin/sh
# L'installatore grafico di CielOS (dalla ISO): disco, utente, lingua, Ciel, poi installa (cielos-installa-sistema).
#   cielos-installatore       apre la finestra dell'installazione (dalla ISO live)
case "${1:-}" in aiuto|--aiuto|-h|help) awk 'NR>1 && /^#/ { sub(/^# ?/, ""); print; next } NR>1 { exit }' "$0"; exit 0 ;; esac
R=${CIELOS_DIR:-$(dirname "$(readlink -f "$0")")/..}
exec qs -n -p "$R/app/installa"
