{
  "manifest_version": 2,
  "name": "Ciel per CielFox",
  "version": "1.2",
  "description": "Ciel nel browser: chiedile qualcosa sulla pagina, dalle un compito da fare nel browser.",
  "browser_specific_settings": {
    "gecko": {
      "id": "ciel@cielos",
      "strict_min_version": "128.0"
    }
  },
  "icons": {
    "16": "icone/16.png",
    "32": "icone/32.png",
    "48": "icone/48.png",
    "128": "icone/128.png"
  },
  "permissions": [
    "nativeMessaging",
    "tabs",
    "<all_urls>",
    "theme",
    "proxy",
    "storage",
    "webNavigation",
    "privacy",
    "management",
    "browsingData"
  ],
  "background": {
    "scripts": [
      "sfondo.js"
    ],
    "persistent": true
  },
  "sidebar_action": {
    "default_title": "Ciel",
    "default_panel": "pannello/pannello.html",
    "default_icon": {
      "16": "icone/16.png",
      "32": "icone/32.png"
    },
    "open_at_install": true
  },
  "browser_action": {
    "default_title": "Ciel (Alt+C)",
    "default_icon": {
      "16": "icone/16.png",
      "32": "icone/32.png"
    },
    "default_area": "navbar"
  },
  "commands": {
    "_execute_sidebar_action": {
      "suggested_key": {
        "default": "Alt+C"
      },
      "description": "Apri o chiudi Ciel"
    }
  },
  "chrome_url_overrides": {
    "newtab": "nuovascheda/nuovascheda.html"
  },
  "chrome_settings_overrides": {
    "homepage": "nuovascheda/nuovascheda.html",
    "search_provider": {
      "name": "Google",
      "keyword": "@google",
      "search_url": "https://www.google.com/search?q={searchTerms}",
      "suggest_url": "https://www.google.com/complete/search?client=firefox&q={searchTerms}",
      "favicon_url": "https://www.google.com/favicon.ico",
      "encoding": "UTF-8",
      "is_default": false
    }
  },
  "options_ui": {
    "page": "impostazioni/impostazioni.html",
    "open_in_tab": true
  }
}