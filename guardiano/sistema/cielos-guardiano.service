[Unit]
Description=Il guardiano di CielOS (azioni da amministratore approvate con la password)
Documentation=file:///usr/lib/cielos/guardiano/PROGETTO.md

[Service]
Type=dbus
BusName=org.cielos.Guardiano
ExecStart=/usr/bin/python3 -I /usr/lib/cielos/guardiano/guardiano.py
# root, con poche protezioni: deve poter fare tutto quello che fa pacman. Niente ProtectKernelModules (rende
# /usr/lib/modules inaccessibile: un aggiornamento del kernel falliva), niente RestrictSUIDSGID (sudo, passwd e
# shadow hanno file setuid: aggiornarli falliva), niente ProtectKernelTunables/ControlGroups (i ganci di pacman
# applicano sysctl e ricaricano systemd). Trovato dalla prova degli aggiornamenti nella VM (14/10).
PrivateTmp=yes
ProtectHome=read-only
ProtectClock=yes
LockPersonality=yes
