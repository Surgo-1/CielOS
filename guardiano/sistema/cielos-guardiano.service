[Unit]
Description=Il guardiano di CielOS (azioni da amministratore approvate con la password)
Documentation=file:///usr/lib/cielos/guardiano/PROGETTO.md

[Service]
Type=dbus
BusName=org.cielos.Guardiano
ExecStart=/usr/bin/python3 -I /usr/lib/cielos/guardiano/guardiano.py
# root, ma con meno porte aperte possibile: niente dispositivi, kernel e home in scrittura
PrivateTmp=yes
ProtectHome=read-only
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictSUIDSGID=yes
LockPersonality=yes
NoNewPrivileges=no
