[Unit]
Description=Ciel, la shell (barra, lanciatore, notifiche, blocco, avatar)
After=graphical-session.target
PartOf=graphical-session.target
# (graphical-session.target con questo Hyprland non si accende: lo fa partire hypr-user.lua all'accesso)
# attiva solo se l'hai scelta (ciel-shell-scegli ciel); all'accesso la fa partire Hyprland (hypr-user.lua),
# dopo aver fermato caelestia: così il servizio delle notifiche è suo
ConditionPathExists=%h/.config/cielos/shell-attiva

[Service]
# con il nome «ciel-shell» (un collegamento a qs): ananicy-cpp mette ogni «qs» a priorità bassa e le animazioni
# scatterebbero quando la CPU lavora
ExecStart=/bin/sh -c 'for i in $(seq 120); do W=$(systemctl --user show-environment | sed -n "s/^WAYLAND_DISPLAY=//p"); [ -n "$W" ] && [ -S "$XDG_RUNTIME_DIR/$W" ] && exec env WAYLAND_DISPLAY="$W" %h/cielos/bin/ciel-shell -c ciel -n; sleep 1; done; exit 1'
Restart=on-failure
RestartSec=2
