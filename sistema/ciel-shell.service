[Unit]
Description=Ciel, la shell (barra, lanciatore, notifiche, blocco, avatar)
After=graphical-session.target
PartOf=graphical-session.target
# (graphical-session.target con questo Hyprland non si accende: lo fa partire hypr-user.lua all'accesso)
# attiva solo se l'hai scelta (ciel-shell-scegli ciel); all'accesso la fa partire Hyprland (hypr-user.lua),
# dopo aver fermato caelestia: così il servizio delle notifiche è suo
ConditionPathExists=%h/.config/cielos/shell-attiva

[Service]
# con il nome «ciel-shell» (un collegamento a qs): ananicy-cpp mette ogni «qs» a priorità bassa e le animazioni
# scatterebbero quando la CPU lavora
# le icone delle app (lanciatore, barra): il tema di icone scelto (gsettings), altrimenti Papirus-Dark o Adwaita; senza,
# Qt guarda solo in hicolor e molte app restano senza icona (Avahi, Monitor di sistema: 15/10)
ExecStart=/bin/sh -c 'I=$(gsettings get org.gnome.desktop.interface icon-theme 2>/dev/null | tr -d "\x27"); for I in "$I" Papirus-Dark Adwaita; do [ -n "$I" ] && [ -d "/usr/share/icons/$I" ] && break; done; for i in $(seq 120); do W=$(systemctl --user show-environment | sed -n "s/^WAYLAND_DISPLAY=//p"); [ -n "$W" ] && [ -S "$XDG_RUNTIME_DIR/$W" ] && exec env WAYLAND_DISPLAY="$W" QS_ICON_THEME="$I" %h/cielos/bin/ciel-shell -c ciel -n; sleep 1; done; exit 1'
# Niente pagine enormi (THP) per la shell: il kernel le forma da 2 MB piene e per un'app Qt non servono a niente,
# ma costano ~190 MB di memoria (misurato: 390 MB con THP, 280 MB senza). Il resto del PC non cambia.
MemoryTHP=disable
Restart=on-failure
# le app aperte dalla shell nascono dentro questo servizio: fermarlo (o riavviarlo) deve chiudere solo la shell,
# non le app (prima chiudeva Claude Desktop e rischiava di uccidere un aggiornamento in corso: 14/10).
# Il lanciatore ora le mette ognuna nel suo «scope» (bin/ciel-apri); questo resta come rete di sicurezza.
KillMode=process
RestartSec=2
