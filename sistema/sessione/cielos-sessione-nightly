#!/bin/bash
# La sessione «CielOS Nightly» (dal login, accanto a CielOS): la stessa Hyprland, la stessa configurazione, i suoi
# comandi — ma al posto della shell stabile si accende la Nightly. È la sorella sperimentale: qui si provano le cose
# nuove, e quello che funziona passa nella stabile.
#   Scegliendola dal login, la Nightly parte da sola (il servizio non ha bisogno del file «attiva»).
#   Per tornare alla stabile: scegli «CielOS» al login, o ferma il servizio e accendi ciel-shell.
set -u
export CIELOS_NIGHTLY=1
C=${XDG_CONFIG_HOME:-$HOME/.config}
mkdir -p "$C/cielos-nightly"
: > "$C/cielos-nightly/attiva"
# il segno della sessione: finché c'è, la shell stabile non parte (ConditionPathExists= nella sua unità). La toglie
# la sessione stabile all'accesso — così non si vedono mai due barre insieme (era il difetto: barra laterale + barra
# in alto, entrambe accese).
: > "$C/cielos-nightly/sessione"
# e se una delle due è rimasta accesa da prima, si spegne: una sola shell per sessione
systemctl --user stop ciel-nightly >/dev/null 2>&1 || true
systemctl --user stop ciel-shell >/dev/null 2>&1 || true
exec /usr/bin/cielos-sessione "$@"
