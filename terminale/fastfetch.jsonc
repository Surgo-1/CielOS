// Il saluto del terminale di CielOS (ciel.fish): il logo di CielOS (l'anello aperto con la stella) e poche righe, quelle che si leggono in un attimo.
// Moduli scelti tra i veloci (niente pacchetti né GPU, che costano decine di millisecondi).
{
  "logo": {
    "type": "data",
    "source": "$1    ▄▄▄▄▄▄▖    \n$1 ▗▟▛▀      ▀   \n$1▗█▘  $3╭      $2✦  \n$1▐▌   $3│       $1▄ \n$1▝█   $3╰      $1▗█ \n$1 ▝█▄      ▗▄▛▘ \n$1   ▝▀▜███▛▀▘   ",
    "color": { "1": "yellow", "2": "bright_white", "3": "bright_yellow" },
    "padding": { "left": 2, "right": 3, "top": 0 }
  },
  "display": {
    "separator": "  ",
    "color": { "keys": "yellow", "title": "bright_yellow" },
    "key": { "width": 11 }
  },
  "modules": [
    { "type": "title", "format": "{user-name}{at-symbol-colored}CielOS" },
    // il kernel col nome di CielOS: «CielOS-7.2.9» (la versione di Linux, senza il nome della distro da cui viene)
    { "type": "command", "key": "kernel", "shell": "/bin/sh", "text": "echo CielOS-$(uname -r | cut -d- -f1)" },
    { "type": "uptime", "key": "acceso da", "format": "{?days}{days} g {?}{hours} h {minutes} min" },
    { "type": "memory", "key": "memoria", "format": "{used} di {total}" },
    { "type": "disk", "key": "disco", "folders": "/", "format": "{size-used} di {size-total}" }
  ]
}
