# Archil (https://console.archil.com/api-keys): chiave API, comincia con «key-», non un token di disco (adt_…).
ARCHIL_API_KEY=
# Regione della chiave: vale solo nella regione in cui è stata creata (exec: aws-us-east-1, aws-us-west-2, aws-eu-west-1).
ARCHIL_REGION=aws-us-east-1
# Disco usato da archivio/ (dsk-…); se vuoto, prove/verifica-archil.py ne crea uno.
ARCHIL_DISK_ID=
